{
  "name": "pcb-spice-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "exports": "./src/pipeline.mjs",
  "files": [
    "src",
    "scripts/setup-tools.py",
    "scripts/plot.py",
    "scripts/audit-eye.mjs",
    "requirements.lock.txt",
    "toolchain-lock.json",
    "vendor/ibis-to-spice-handoff.json",
    "vendor/ibis-to-spice-0.0.1.tgz",
    "vendor/native-ibis-packages-handoff.json",
    "vendor/tscircuit-core-ibis-experimental.tgz",
    "vendor/tscircuit-props-ibis-experimental.tgz"
  ],
  "bin": {
    "pcb-spice-pipeline": "src/cli.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:native": "node --import tsx --test tests/native.integration.mjs tests/real-board.integration.mjs",
    "prove": "node scripts/prove.mjs",
    "example": "node src/cli.mjs examples/straight.json --out runs/straight",
    "routed": "node src/cli.mjs examples/am3352.json --out runs/am3352",
    "tsx": "tsx src/cli.mjs examples/board.tsx --out runs/tsx",
    "eye": "tsx src/cli.mjs examples/am3352-eye.tsx --out runs/am3352-eye",
    "setup:tools": "python3 scripts/setup-tools.py"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "react": "19.2.4",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@tscircuit/core": "file:vendor/tscircuit-core-ibis-experimental.tgz",
    "@tscircuit/ibis-to-spice": "file:vendor/ibis-to-spice-0.0.1.tgz",
    "@tscircuit/props": "file:vendor/tscircuit-props-ibis-experimental.tgz",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@tscircuit/core": "0.0.2148",
    "@tscircuit/props": "0.0.702",
    "@tscircuit/ibis-to-spice": "0.0.1"
  }
}
