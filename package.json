{
  "name": "@tscircuit/signal-integrity-pipeline",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/signal-integrity-pipeline.git"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --import tsx --test 'tests/**/*.test.mjs' 'tests/**/*.test.ts' 'tests/**/*.test.tsx'",
    "test:native": "npm run build && node --import tsx --test tests/general.integration.mjs",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json && tsc -p examples/tsconfig.json --noEmit",
    "build": "node scripts/build-client.mjs --clean && tsc && node scripts/fix-dist-imports.mjs && node scripts/bundle.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "pretypecheck": "node scripts/build-client.mjs",
    "test:package": "node --import tsx scripts/test-package.mjs",
    "check:modules": "tsx scripts/check-modules.ts",
    "check:vocabulary": "tsx scripts/check-vocabulary.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@tscircuit/ibis-to-spice": "https://api.github.com/repos/tscircuit/ibis-to-spice/tarball/ad1ec9e640a92a4d370fc76acbbd8db245563317",
    "clipper2-ts": "2.0.1-18",
    "earcut": "3.2.4",
    "format-si-unit": "0.0.12",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tscircuit/core": "0.0.2217",
    "@tscircuit/props": "0.0.712",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "circuit-json": "0.0.541",
    "circuit-to-svg": "0.0.454",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-jsdoc": "65.3.15",
    "react": "19.2.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "peerDependencies": {
    "@tscircuit/core": ">=0.0.2188",
    "@tscircuit/props": ">=0.0.705",
    "circuit-json": "*",
    "react": "^19.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependenciesMeta": {
    "@tscircuit/core": {
      "optional": true
    },
    "@tscircuit/props": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
