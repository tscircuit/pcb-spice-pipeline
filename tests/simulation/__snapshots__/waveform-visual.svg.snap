9545901088566 271.662410966268,456.81914386507196 281.18935626931864,477.0770278860369 319.29713748152136,458.5073014379788 1033.8180352103213,460.19545901088566" fill="none" stroke="#9333ea" stroke-linejoin="round" stroke-width="1.0280876226313667"/></g><text data-type="text" data-label="6 · Transient: ngspice samples · candidate-unqualified" data-x="2" data-y="178" x="40.00000000000002" y="280.91318371186674" fill="#a16207" font-size="15.764010213680956" font-family="sans-serif" text-anchor="start" dominant-baseline="central">6 · Transient: ngspice samples · candidate-unqualified</text><text data-type="text" data-label="-0.4 V" data-x="290" data-y="121.743842" x="1026.9641177261121" y="473.7007161671819" fill="#dc2626" font-size="12.337051471576402" font-family="sans-serif" text-anchor="end" dominant-baseline="central">-0.4 V</text><text data-type="text" data-label="0 V" data-x="2" data-y="125.684729" x="40.00000000000002" y="460.19545901088566" fill="#64748b" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">0 V</text><text data-type="text" data-label="1 V" data-x="2" data-y="135.536946" x="40.00000000000002" y="426.43231783362455" fill="#64748b" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">1 V</text><text data-type="text" data-label="1.9 V" data-x="290" data-y="144.403941" x="1026.9641177261121" y="396.0454918021772" fill="#dc2626" font-size="12.337051471576402" font-family="sans-serif" text-anchor="end" dominant-baseline="central">1.9 V</text><text data-type="text" data-label="2 V" data-x="2" data-y="145.389163" x="40.00000000000002" y="392.66917665636345" fill="#64748b" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">2 V</text><text data-type="text" data-label="3 V" data-x="2" data-y="155.241379" x="40.00000000000002" y="358.9060389060611" fill="#64748b" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">3 V</text><text data-type="text" data-label="0.00" data-x="13" data-y="113" x="77.69654616315015" y="503.6655019486629" fill="#64748b" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">0.00</text><text data-type="text" data-label="0.25" data-x="82.5" data-y="113" x="315.87017873941676" y="503.6655019486629" fill="#64748b" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">0.25</text><text data-type="text" data-label="0.50" data-x="152" data-y="113" x="554.0438113156835" y="503.6655019486629" fill="#64748b" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">0.50</text><text data-type="text" data-label="0.75" data-x="221.5" data-y="113" x="792.2174438919501" y="503.6655019486629" fill="#64748b" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">0.75</text><text data-type="text" data-label="1.00" data-x="291" data-y="113" x="1030.3910764682169" y="503.6655019486629" fill="#64748b" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">1.00</text><text data-type="text" data-label="Voltage (V) · Red dashed: 1.9 V / −0.4 V limits" data-x="2" data-y="164" x="40.00000000000002" y="328.8906061013305" fill="#475569" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Voltage (V) · Red dashed: 1.9 V / −0.4 V limits</text><text data-type="text" data-label="Time (ns)" data-x="140" data-y="108" x="512.9203064104288" y="520.8002956591856" fill="#475569" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Time (ns)</text><text data-type="text" data-label="DATA" data-x="14" data-y="172" x="81.12350490525469" y="301.4749361644941" fill="#2563eb" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">DATA</text><text data-type="text" data-label="VICTIM" data-x="60" data-y="172" x="238.76360704206428" y="301.4749361644941" fill="#9333ea" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">VICTIM</text><g id="crosshair" style="display: none"><line id="crosshair-h" y1="0" y2="800" stroke="#666" stroke-width="0.5"/><line id="crosshair-v" x1="0" x2="1100" stroke="#666" stroke-width="0.5"/><text id="coordinates" font-family="monospace" font-size="12" fill="#666"></text></g><script><![CDATA[
              document.currentScript.parentElement.addEventListener('mousemove', (e) => {
                const svg = e.currentTarget;
                const rect = svg.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const crosshair = svg.getElementById('crosshair');
                const h = svg.getElementById('crosshair-h');
                const v = svg.getElementById('crosshair-v');
                const coords = svg.getElementById('coordinates');
                
                crosshair.style.display = 'block';
                h.setAttribute('x1', '0');
                h.setAttribute('x2', '1100');
                h.setAttribute('y1', y);
                h.setAttribute('y2', y);
                v.setAttribute('x1', x);
                v.setAttribute('x2', x);
                v.setAttribute('y1', '0');
                v.setAttribute('y2', '800');

                // Calculate real coordinates using inverse transformation
                const matrix = {"a":3.426958742104556,"c":0,"e":33.14608251579091,"b":0,"d":-3.426958742104556,"f":890.9118398064777};
                // Manually invert and apply the affine transform
                // Since we only use translate and scale, we can directly compute:
                // x' = (x - tx) / sx
                // y' = (y - ty) / sy
                const sx = matrix.a;
                const sy = matrix.d;
                const tx = matrix.e; 
                const ty = matrix.f;
                const realPoint = {
                  x: (x - tx) / sx,
                  y: (y - ty) / sy // Flip y back since we used negative scale
                }
                
                coords.textContent = `(${realPoint.x.toFixed(2)}, ${realPoint.y.toFixed(2)})`;
                coords.setAttribute('x', (x + 5).toString());
                coords.setAttribute('y', (y - 5).toString());
              });
              document.currentScript.parentElement.addEventListener('mouseleave', () => {
                document.currentScript.parentElement.getElementById('crosshair').style.display = 'none';
              });
            ]]></script></svg>