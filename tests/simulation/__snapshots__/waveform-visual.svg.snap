<svg width="1100" height="800" viewBox="0 0 1100 800" xmlns="http://www.w3.org/2000/svg"><rect width="100%" height="100%" fill="white"/><g><polyline data-points="14,158 14,118 292,118" data-type="line" data-label="" points="81.12350490525469,349.4523585539579 81.12350490525469,486.5307082381401 1033.8180352103213,486.5307082381401" fill="none" stroke="#64748b" stroke-linejoin="round" stroke-width="0.6853917484209112"/></g><g><polyline data-points="14,121.743842 292,121.743842" data-type="line" data-label="-0.4 V" points="81.12350490525469,473.7007161671819 1033.8180352103213,473.7007161671819" fill="none" stroke="#dc2626" stroke-linejoin="round" stroke-width="0.5140438113156833" stroke-dasharray="1 1"/></g><g><polyline data-points="14,125.684729 292,125.684729" data-type="line" data-label="0 V" points="81.12350490525469,460.19545901088566 1033.8180352103213,460.19545901088566" fill="none" stroke="#e2e8f0" stroke-linejoin="round" stroke-width="0.5140438113156833" stroke-dasharray="1 1"/></g><g><polyline data-points="14,135.536946 292,135.536946" data-type="line" data-label="1 V" points="81.12350490525469,426.43231783362455 1033.8180352103213,426.43231783362455" fill="none" stroke="#e2e8f0" stroke-linejoin="round" stroke-width="0.5140438113156833" stroke-dasharray="1 1"/></g><g><polyline data-points="14,144.403941 292,144.403941" data-type="line" data-label="1.9 V" points="81.12350490525469,396.0454918021772 1033.8180352103213,396.0454918021772" fill="none" stroke="#dc2626" stroke-linejoin="round" stroke-width="0.5140438113156833" stroke-dasharray="1 1"/></g><g><polyline data-points="14,145.389163 292,145.389163" data-type="line" data-label="2 V" points="81.12350490525469,392.66917665636345 1033.8180352103213,392.66917665636345" fill="none" stroke="#e2e8f0" stroke-linejoin="round" stroke-width="0.5140438113156833" stroke-dasharray="1 1"/></g><g><polyline data-points="14,155.241379 292,155.241379" data-type="line" data-label="3 V" points="81.12350490525469,358.90603890