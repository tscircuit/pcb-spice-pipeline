<svg width="1100" height="800" viewBox="0 0 1100 800" xmlns="http://www.w3.org/2000/svg"><rect width="100%" height="100%" fill="white"/><g><polyline data-points="47.5,50 47.5,50 72.5,50 72.5,50" data-type="line" data-label="" points="404.37134778510836,381.3383600377002 404.37134778510836,381.3383600377002 574.0226201696512,381.3383600377002 574.0226201696512,381.3383600377002" fill="none" stroke="#2563eb" stroke-linejoin="round" stroke-width="3.393025447690858"/></g><g><polyline data-points="47.5,51.09375 47.5,51.09375 72.5,51.09375 72.5,51.09375" data-type="line" data-label="" points="404.37134778510836,373.91611687087646 404.37134778510836,373.91611687087646 574.0226201696512,373.91611687087646 574.0226201696512,373.91611687087646" fill="none" stroke="#2563eb" stroke-linejoin="round" stroke-width="3.393025447690858"/></g><g><polyline data-points="81.25,57.8125 38.75,57.8125 38.75,65 81.25,65 81.25,57.8125" data-type="line" data-label="" points="633.4005655042413,328.32233741753055 344.9934024505183,328.32233741753055 344.9934024505183,279.5475966069745 633.4005655042413,279.5475966069745 633.4005655042413,328.32233741753055" fill="none" stroke="#16a34a" stroke-linejoin="round" stroke-width="1.3572101790763433"/></g><g><polyline data-points="81.25,35 38.75,35 38.75,65 81.25,65 81.25,35" data-type="line" data-label="" points="633.4005655042413,483.129123468426 344.9934024505183,483.129123468426 344.9934024505183,279.5475966069745 633.4005655042413,279.5475966069745 633.4005655042413,483.129123468426" fill="none" stroke="#16a34a" stroke-linejoin="round" stroke-width="1.3572101790763433"/></g><g><polyline data-points="47.5,50 72.5,50" data-type="line" data-label="" points="404.37134778510836,381.3383600377002 574.0226201696512,381.3383600377002" fill="none" stroke="#2563eb" stroke-linejoin="round" stroke-width="3.053722902921772"/></g><g><polyline data-points="47.5,51.09375 72.5,51.09375" data-type="line" data-label="" points="404.37134778510836,373.91611687087646 574.0226201696512,373.91611687087646" fill="none" stroke="#0891b2" stroke-linejoin="round" stroke-width="3.053722902921772"/></g><g><polyline data-points="47.5,49.2 47.5,50.8" data-type="line" data-label="" points="404.37134778510836,386.76720075400556 404.37134778510836,375.9095193213949" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.696512723845429"/></g><g><polyline data-points="55.833333,49.2 55.833333,50.8" data-type="line" data-label="" points="460.92176965127237,386.76720075400556 460.92176965127237,375.9095193213949" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.696512723845429"/></g><g><polyline data-points="55.833333,49.2 55.833333,50.8" data-type="line" data-label="" points="460.92176965127237,386.76720075400556 460.92176965127237,375.9095193213949" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.696512723845429"/></g><g><polyline data-points="64.166667,49.2 64.166667,50.8" data-type="line" data-label="" points="517.4721983034873,386.76720075400556 517.4721983034873,375.9095193213949" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.696512723845429"/></g><g><polyline data-points="64.166667,49.2 64.166667,50.8" data-type="line" data-label="" points="517.4721983034873,386.76720075400556 517.4721983034873,375.9095193213949" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.696512723845429"/></g><g><polyline data-points="72.5,49.2 72.5,50.8" data-type="line" data-label="" points="574.0226201696512,386.76720075400556 574.0226201696512,375.9095193213949" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.696512723845429"/></g><g><polyline data-points="47.5,50.29375 47.5,51.89375" data-type="line" data-label="" points="404.37134778510836,379.3449575871818 404.37134778510836,368.48727615457113" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.696512723845429"/></g><g><polyline data-points="55.833333,50.29375 55.833333,51.89375" data-type="line" data-label="" points="460.92176965127237,379.3449575871818 460.92176965127237,368.48727615457113" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.696512723845429"/></g><g><polyline data-points="55.833333,50.29375 55.833333,51.89375" data-type="line" data-label="" points="460.92176965127237,379.3449575871818 460.92176965127237,368.48727615457113" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.696512723845429"/></g><g><polyline data-points="64.166667,50.29375 64.166667,51.89375" data-type="line" data-label="" points="517.4721983034873,379.3449575871818 517.4721983034873,368.48727615457113" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.696512723845429"/></g><g><polyline data-points="64.166667,50.29375 64.166667,51.89375" data-type="line" data-label="" points="517.4721983034873,379.3449575871818 517.4721983034873,368.48727615457113" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.696512723845429"/></g><g><polyline data-points="72.5,50.29375 72.5,51.89375" data-type="line" data-label="" points="574.0226201696512,379.3449575871818 574.0226201696512,368.48727615457113" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.696512723845429"/></g><g><rect data-type="rect" data-label="" data-x="60" data-y="50" x="319.5457115928369" y="254.09990574929304" width="339.3025447690858" height="254.47690857681437" fill="none" stroke="#94a3b8" stroke-width="0.1473611111111111"/></g><text data-type="text" data-label="5 · Network: build a coupled ladder" data-x="2" data-y="98" x="95.60603204524027" y="55.60791705937788" fill="#0f172a" font-size="31.21583411875589" font-family="sans-serif" text-anchor="start" dominant-baseline="central">5 · Network: build a coupled ladder</text><text data-type="text" data-label="Board plan · x / y in mm · y points up" data-x="2" data-y="91" x="95.60603204524027" y="103.11027332704987" fill="#334155" font-size="24.429783223374177" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Board plan · x / y in mm · y points up</text><text data-type="text" data-label="2 selected routes; 0/0 neighbour routes shown" data-x="2" data-y="2" x="95.60603204524027" y="707.0688030160226" fill="#64748b" font-size="24.429783223374177" font-family="sans-serif" text-anchor="start" dominant-baseline="central">2 selected routes; 0/0 neighbour routes shown</text><text data-type="text" data-label="TX0.Y → RX0.A" data-x="2" data-y="28" x="95.60603204524027" y="530.631479736098" fill="#2563eb" font-size="24.429783223374177" font-family="sans-serif" text-anchor="start" dominant-baseline="central">TX0.Y → RX0.A</text><text data-type="text" data-label="TX1.Y → RX1.A" data-x="62" data-y="28" x="502.7690857681432" y="530.631479736098" fill="#0891b2" font-size="24.429783223374177" font-family="sans-serif" text-anchor="start" dominant-baseline="central">TX1.Y → RX1.A</text><text data-type="text" data-label="Net colours above · Orange: via" data-x="2" data-y="12" x="95.60603204524027" y="639.2082940622054" fill="#475569" font-size="24.429783223374177" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Net colours above · Orange: via</text><text data-type="text" data-label="Magenta: join · Green: pour" data-x="2" data-y="7" x="95.60603204524027" y="673.138548539114" fill="#475569" font-size="24.429783223374177" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Magenta: join · Green: pour</text><text data-type="text" data-label="6 cells · max cell delay 26.25 ps" data-x="2" data-y="87" x="95.60603204524027" y="130.25447690857675" fill="#a16207" font-size="24.429783223374177" font-family="sans-serif" text-anchor="start" dominant-baseline="central">6 cells · max cell delay 26.25 ps</text><text data-type="text" data-label="Amber: cells · Purple: oblique encounters" data-x="2" data-y="81" x="95.60603204524027" y="170.97078228086707" fill="#475569" font-size="24.429783223374177" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Amber: cells · Purple: oblique encounters</text><text data-type="text" data-label="Orange rings: vias" data-x="2" data-y="76" x="95.60603204524027" y="204.9010367577756" fill="#475569" font-size="24.429783223374177" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Orange rings: vias</text><text data-type="text" data-label="12/12 node ticks shown · 0 oblique encounters · native not run" data-x="2" data-y="71" x="95.60603204524027" y="238.83129123468422" fill="#64748b" font-size="24.429783223374177" font-family="sans-serif" text-anchor="start" dominant-baseline="central">12/12 node ticks shown · 0 oblique encounters · native not run</text><text data-type="text" data-label="Input: 4 bound IBIS models · 3 probes" data-x="2" data-y="-4" x="95.60603204524027" y="747.7851083883129" fill="#475569" font-size="24.429783223374177" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Input: 4 bound IBIS models · 3 probes</text><g id="crosshair" style="display: none"><line id="crosshair-h" y1="0" y2="800" stroke="#666" stroke-width="0.5"/><line id="crosshair-v" x1="0" x2="1100" stroke="#666" stroke-width="0.5"/><text id="coordinates" font-family="monospace" font-size="12" fill="#666"></text></g><script><![CDATA[
              document.currentScript.parentElement.addEventListener('mousemove', (e) => {
                const svg = e.currentTarget;
                const rect = svg.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const crosshair = svg.getElementById('crosshair');
                const h = svg.getElementById('crosshair-h');
                const v = svg.getElementById('crosshair-v');
                const coords = svg.getElementById('coordinates');
                
                crosshair.style.display = 'block';
                h.setAttribute('x1', '0');
                h.setAttribute('x2', '1100');
                h.setAttribute('y1', y);
                h.setAttribute('y2', y);
                v.setAttribute('x1', x);
                v.setAttribute('x2', x);
                v.setAttribute('y1', '0');
                v.setAttribute('y2', '800');

                // Calculate real coordinates using inverse transformation
                const matrix = {"a":6.786050895381716,"c":0,"e":82.03393025447684,"b":0,"d":-6.786050895381716,"f":720.640904806786};
                // Manually invert and apply the affine transform
                // Since we only use translate and scale, we can directly compute:
                // x' = (x - tx) / sx
                // y' = (y - ty) / sy
                const sx = matrix.a;
                const sy = matrix.d;
                const tx = matrix.e; 
                const ty = matrix.f;
                const realPoint = {
                  x: (x - tx) / sx,
                  y: (y - ty) / sy // Flip y back since we used negative scale
                }
                
                coords.textContent = `(${realPoint.x.toFixed(2)}, ${realPoint.y.toFixed(2)})`;
                coords.setAttribute('x', (x + 5).toString());
                coords.setAttribute('y', (y - 5).toString());
              });
              document.currentScript.parentElement.addEventListener('mouseleave', () => {
                document.currentScript.parentElement.getElementById('crosshair').style.display = 'none';
              });
            ]]></script></svg>