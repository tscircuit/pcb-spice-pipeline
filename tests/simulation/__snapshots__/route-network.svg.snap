<svg width="1100" height="800" viewBox="0 0 1100 800" xmlns="http://www.w3.org/2000/svg"><rect width="100%" height="100%" fill="white"/><g><polyline data-points="47.5,50 47.5,50 72.5,50 72.5,50" data-type="line" data-label="" points="395.6423576423575,401.7982017982018 395.6423576423575,401.7982017982018 575.4625374625374,401.7982017982018 575.4625374625374,401.7982017982018" fill="none" stroke="#2563eb" stroke-linejoin="round" stroke-width="3.5964035964035967"/></g><g><polyline data-points="47.5,51.09375 47.5,51.09375 72.5,51.09375 72.5,51.09375" data-type="line" data-label="" points="395.6423576423575,393.9310689310689 395.6423576423575,393.9310689310689 575.4625374625374,393.9310689310689 575.4625374625374,393.9310689310689" fill="none" stroke="#2563eb" stroke-linejoin="round" stroke-width="3.5964035964035967"/></g><g><polyline data-points="81.25,57.8125 38.75,57.8125 38.75,65 81.25,65 81.25,57.8125" data-type="line" data-label="" points="638.3996003996003,345.60439560439556 332.7052947052946,345.60439560439556 332.7052947052946,293.9060939060939 638.3996003996003,293.9060939060939 638.3996003996003,345.60439560439556" fill="none" stroke="#16a34a" stroke-linejoin="round" stroke-width="1.4385614385614387"/></g><g><polyline data-points="81.25,35 38.75,35 38.75,65 81.25,65 81.25,35" data-type="line" data-label="" points="638.3996003996003,509.69030969030973 332.7052947052946,509.69030969030973 332.7052947052946,293.9060939060939 638.3996003996003,293.9060939060939 638.3996003996003,509.69030969030973" fill="none" stroke="#16a34a" stroke-linejoin="round" stroke-width="1.4385614385614387"/></g><g><polyline data-points="47.5,50 72.5,50" data-type="line" data-label="" points="395.6423576423575,401.7982017982018 575.4625374625374,401.7982017982018" fill="none" stroke="#2563eb" stroke-linejoin="round" stroke-width="3.2367632367632373"/></g><g><polyline data-points="47.5,51.09375 72.5,51.09375" data-type="line" data-label="" points="395.6423576423575,393.9310689310689 575.4625374625374,393.9310689310689" fill="none" stroke="#0891b2" stroke-linejoin="round" stroke-width="3.2367632367632373"/></g><g><polyline data-points="47.5,49.2 47.5,50.8" data-type="line" data-label="" points="395.6423576423575,407.5524475524475 395.6423576423575,396.04395604395603" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.7982017982017984"/></g><g><polyline data-points="55.833333,49.2 55.833333,50.8" data-type="line" data-label="" points="455.5824151848151,407.5524475524475 455.5824151848151,396.04395604395603" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.7982017982017984"/></g><g><polyline data-points="55.833333,49.2 55.833333,50.8" data-type="line" data-label="" points="455.5824151848151,407.5524475524475 455.5824151848151,396.04395604395603" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.7982017982017984"/></g><g><polyline data-points="64.166667,49.2 64.166667,50.8" data-type="line" data-label="" points="515.5224799200798,407.5524475524475 515.5224799200798,396.04395604395603" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.7982017982017984"/></g><g><polyline data-points="64.166667,49.2 64.166667,50.8" data-type="line" data-label="" points="515.5224799200798,407.5524475524475 515.5224799200798,396.04395604395603" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.7982017982017984"/></g><g><polyline data-points="72.5,49.2 72.5,50.8" data-type="line" data-label="" points="575.4625374625374,407.5524475524475 575.4625374625374,396.04395604395603" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.7982017982017984"/></g><g><polyline data-points="47.5,50.29375 47.5,51.89375" data-type="line" data-label="" points="395.6423576423575,399.68531468531467 395.6423576423575,388.1768231768232" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.7982017982017984"/></g><g><polyline data-points="55.833333,50.29375 55.833333,51.89375" data-type="line" data-label="" points="455.5824151848151,399.68531468531467 455.5824151848151,388.1768231768232" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.7982017982017984"/></g><g><polyline data-points="55.833333,50.29375 55.833333,51.89375" data-type="line" data-label="" points="455.5824151848151,399.68531468531467 455.5824151848151,388.1768231768232" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.7982017982017984"/></g><g><polyline data-points="64.166667,50.29375 64.166667,51.89375" data-type="line" data-label="" points="515.5224799200798,399.68531468531467 515.5224799200798,388.1768231768232" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.7982017982017984"/></g><g><polyline data-points="64.166667,50.29375 64.166667,51.89375" data-type="line" data-label="" points="515.5224799200798,399.68531468531467 515.5224799200798,388.1768231768232" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.7982017982017984"/></g><g><polyline data-points="72.5,50.29375 72.5,51.89375" data-type="line" data-label="" points="575.4625374625374,399.68531468531467 575.4625374625374,388.1768231768232" fill="none" stroke="#f59e0b" stroke-linejoin="round" stroke-width="1.7982017982017984"/></g><g><rect data-type="rect" data-label="" data-x="60" data-y="50" x="305.7322677322676" y="266.9330669330669" width="359.64035964035975" height="269.7302697302697" fill="none" stroke="#94a3b8" stroke-width="0.13902777777777778"/></g><text data-type="text" data-label="4 · Network: build a coupled ladder" data-x="2" data-y="98" x="68.36963036963024" y="56.5434565434565" fill="#0f172a" font-size="33.086913086913086" font-family="sans-serif" text-anchor="start" dominant-baseline="central">4 · Network: build a coupled ladder</text><text data-type="text" data-label="Board plan · x / y in mm · y points up" data-x="2" data-y="91" x="68.36963036963024" y="106.89310689310685" fill="#334155" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Board plan · x / y in mm · y points up</text><text data-type="text" data-label="2 selected routes; 0/0 neighbour routes shown" data-x="2" data-y="2" x="68.36963036963024" y="747.052947052947" fill="#64748b" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">2 selected routes; 0/0 neighbour routes shown</text><text data-type="text" data-label="TX0.Y → RX0.A" data-x="2" data-y="28" x="68.36963036963024" y="560.0399600399601" fill="#2563eb" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">TX0.Y → RX0.A</text><text data-type="text" data-label="TX1.Y → RX1.A" data-x="62" data-y="28" x="499.9380619380619" y="560.0399600399601" fill="#0891b2" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">TX1.Y → RX1.A</text><text data-type="text" data-label="Net colours above · Orange: via" data-x="2" data-y="12" x="68.36963036963024" y="675.1248751248752" fill="#475569" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Net colours above · Orange: via</text><text data-type="text" data-label="Magenta: join · Green: pour" data-x="2" data-y="7" x="68.36963036963024" y="711.0889110889111" fill="#475569" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Magenta: join · Green: pour</text><text data-type="text" data-label="6 cells · max cell delay 26.25 ps" data-x="2" data-y="87" x="68.36963036963024" y="135.66433566433568" fill="#a16207" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">6 cells · max cell delay 26.25 ps</text><text data-type="text" data-label="Amber: cells · Purple: oblique encounters" data-x="2" data-y="81" x="68.36963036963024" y="178.82117882117882" fill="#475569" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Amber: cells · Purple: oblique encounters</text><text data-type="text" data-label="Orange rings: vias" data-x="2" data-y="76" x="68.36963036963024" y="214.78521478521475" fill="#475569" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Orange rings: vias</text><text data-type="text" data-label="12/12 node ticks shown · 0 oblique encounters · native not run" data-x="2" data-y="71" x="68.36963036963024" y="250.74925074925073" fill="#64748b" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">12/12 node ticks shown · 0 oblique encounters · native not run</text><g id="crosshair" style="display: none"><line id="crosshair-h" y1="0" y2="800" stroke="#666" stroke-width="0.5"/><line id="crosshair-v" x1="0" x2="1100" stroke="#666" stroke-width="0.5"/><text id="coordinates" font-family="monospace" font-size="12" fill="#666"></text></g><script><![CDATA[
              document.currentScript.parentElement.addEventListener('mousemove', (e) => {
                const svg = e.currentTarget;
                const rect = svg.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const crosshair = svg.getElementById('crosshair');
                const h = svg.getElementById('crosshair-h');
                const v = svg.getElementById('crosshair-v');
                const coords = svg.getElementById('coordinates');
                
                crosshair.style.display = 'block';
                h.setAttribute('x1', '0');
                h.setAttribute('x2', '1100');
                h.setAttribute('y1', y);
                h.setAttribute('y2', y);
                v.setAttribute('x1', x);
                v.setAttribute('x2', x);
                v.setAttribute('y1', '0');
                v.setAttribute('y2', '800');

                // Calculate real coordinates using inverse transformation
                const matrix = {"a":7.1928071928071935,"c":0,"e":53.984015984015855,"b":0,"d":-7.1928071928071935,"f":761.4385614385615};
                // Manually invert and apply the affine transform
                // Since we only use translate and scale, we can directly compute:
                // x' = (x - tx) / sx
                // y' = (y - ty) / sy
                const sx = matrix.a;
                const sy = matrix.d;
                const tx = matrix.e; 
                const ty = matrix.f;
                const realPoint = {
                  x: (x - tx) / sx,
                  y: (y - ty) / sy // Flip y back since we used negative scale
                }
                
                coords.textContent = `(${realPoint.x.toFixed(2)}, ${realPoint.y.toFixed(2)})`;
                coords.setAttribute('x', (x + 5).toString());
                coords.setAttribute('y', (y - 5).toString());
              });
              document.currentScript.parentElement.addEventListener('mouseleave', () => {
                document.currentScript.parentElement.getElementById('crosshair').style.display = 'none';
              });
            ]]></script></svg>