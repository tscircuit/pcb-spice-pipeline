<svg width="1100" height="800" viewBox="0 0 1100 800" xmlns="http://www.w3.org/2000/svg"><rect width="100%" height="100%" fill="white"/><g><polyline data-points="-3.2,-1.653333 3.2,-1.653333" data-type="line" data-label="" points="150.84242987909352,447.3076863772088 949.7067893680553,447.3076863772088" fill="none" stroke="#11161c" stroke-linejoin="round" stroke-width="332.86019139458614"/></g><g><polyline data-points="-4,0 -4,0 4,0 4,0" data-type="line" data-label="" points="50.98438494297329,240.9344351167458 50.98438494297329,240.9344351167458 1049.5648343041755,240.9344351167458 1049.5648343041755,240.9344351167458" fill="none" stroke="hsla(195, 90%, 62%, 1)" stroke-linejoin="round" stroke-width="12.482255617015028"/></g><g><polyline data-points="-4,0.35 -4,0.35 4,0.35 4,0.35" data-type="line" data-label="" points="50.98438494297329,197.2465404571932 50.98438494297329,197.2465404571932 1049.5648343041755,197.2465404571932 1049.5648343041755,197.2465404571932" fill="none" stroke="hsla(15, 90%, 62%, 1)" stroke-linejoin="round" stroke-width="12.482255617015028"/></g><g><polyline data-points="-2.496,-2.410667 2.944,-2.410667" data-type="line" data-label="" points="238.7175094228793,541.8400521317735 917.7522149884968,541.8400521317735" fill="none" stroke="#2c3642" stroke-linejoin="round" stroke-width="1.1982965392334426"/></g><g><polyline data-points="-2.496,-2.069333 2.944,-2.069333" data-type="line" data-label="" points="238.7175094228793,499.23386974399136 917.7522149884968,499.23386974399136" fill="none" stroke="#8b97a6" stroke-linejoin="round" stroke-width="1.1982965392334426"/></g><g><polyline data-points="-2.496,-1.728 2.944,-1.728" data-type="line" data-label="" points="238.7175094228793,456.62781217876545 917.7522149884968,456.62781217876545" fill="none" stroke="#2c3642" stroke-linejoin="round" stroke-width="1.1982965392334426"/></g><g><polyline data-points="-2.496,-1.386667 2.944,-1.386667" data-type="line" data-label="" points="238.7175094228793,414.02175