ta-label="" data-x="4" data-y="0.35" x="784" y="373" width="12" height="12" fill="#e8a07acc" stroke="black" stroke-width="0.016666666666666666"/></g><g><rect data-type="rect" data-label="" data-x="4" data-y="-3.15" x="778" y="577" width="24" height="24" fill="#e8a07acc" stroke="black" stroke-width="0.016666666666666666"/></g><g><rect data-type="rect" data-label="" data-x="4" data-y="3.85" x="778" y="157" width="24" height="24" fill="#e8a07acc" stroke="black" stroke-width="0.016666666666666666"/></g><g><rect data-type="rect" data-label="" data-x="-4" data-y="0" data-ccw-rotation-degrees="0" x="298" y="238" width="24" height="324" fill="none" stroke="#cbd5e1" stroke-width="0.016666666666666666"/></g><g><rect data-type="rect" data-label="" data-x="-4" data-y="-2.5" data-ccw-rotation-degrees="0" x="301" y="541" width="18" height="18" fill="none" stroke="#cbd5e1" stroke-width="0.016666666666666666"/></g><g><rect data-type="rect" data-label="" data-x="4" data-y="0" data-ccw-rotation-degrees="0" x="778" y="238" width="24" height="324" fill="none" stroke="#cbd5e1" stroke-width="0.016666666666666666"/></g><g><rect data-type="rect" data-label="" data-x="4" data-y="-2.5" data-ccw-rotation-degrees="0" x="781" y="541" width="18" height="18" fill="none" stroke="#cbd5e1" stroke-width="0.016666666666666666"/></g><g><rect data-type="rect" data-label="" data-x="-4" data-y="0.35" data-ccw-rotation-degrees="0" x="298" y="157" width="24" height="444" fill="none" stroke="#cbd5e1" stroke-width="0.016666666666666666"/></g><g><rect data-type="rect" data-label="" data-x="-4" data-y="-3.15" data-ccw-rotation-degrees="0" x="301" y="580" width="18" height="18" fill="none" stroke="#cbd5e1" stroke-width="0.016666666666666666"/></g><g><rect data-type="rect" data-label="" data-x="4" data-y="0.35" data-ccw-rotation-degrees="0" x="778" y="157" width="24" height="444" fill="none" stroke="#cbd5e1" stroke-width="0.016666666666666666"/></g><g><rect data-type="rect" data-label="" data-x="4" data-y="-3.15" data-ccw-rotation-degrees="0" x="781" y="580" width="18" height="18" fill="none" stroke="#cbd5e1" stroke-width="0.016666666666666666"/></g><g><polygon data-type="polygon" data-label="" data-points="6.8,2.5 -6.8,2.5 -6.8,4.8 6.8,4.8" points="958,250 142,250 142,112 958,112" fill="#e8a07a30" stroke="black" stroke-width="0.016666666666666666"/></g><g><polygon data-type="polygon" data-label="" data-points="6.8,-4.8 -6.8,-4.8 -6.8,4.8 6.8,4.8" points="958,688 142,688 142,112 958,112" fill="#7fa7d630" stroke="black" stroke-width="0.016666666666666666"/></g><circle data-type="circle" data-label="" data-x="-4" data-y="-2.5" cx="310" cy="550" r="9" fill="#94a3b8" stroke="black" stroke-width="0.016666666666666666"/><circle data-type="circle" data-label="" data-x="-4" data-y="-2.5" cx="310" cy="550" r="4.5" fill="#ffffff" stroke="black" stroke-width="0.016666666666666666"/><circle data-type="circle" data-label="" data-x="4" data-y="-2.5" cx="790" cy="550" r="9" fill="#94a3b8" stroke="black" stroke-width="0.016666666666666666"/><circle data-type="circle" data-label="" data-x="4" data-y="-2.5" cx="790" cy="550" r="4.5" fill="#ffffff" stroke="black" stroke-width="0.016666666666666666"/><circle data-type="circle" data-label="" data-x="-4" data-y="-3.15" cx="310" cy="589" r="9" fill="#94a3b8" stroke="black" stroke-width="0.016666666666666666"/><circle data-type="circle" data-label="" data-x="-4" data-y="-3.15" cx="310" cy="589" r="4.5" fill="#ffffff" stroke="black" stroke-width="0.016666666666666666"/><circle data-type="circle" data-label="" data-x="4" data-y="-3.15" cx="790" cy="589" r="9" fill="#94a3b8" stroke="black" stroke-width="0.016666666666666666"/><circle data-type="circle" data-label="" data-x="4" data-y="-3.15" cx="790" cy="589" r="4.5" fill="#ffffff" stroke="black" stroke-width="0.016666666666666666"/><text data-type="text" data-label="4 · Bindings" data-x="-5.065412" data-y="3.30438" x="246.07527999999996" y="201.7372" fill="#0f172a" font-size="11.44002" font-family="sans-serif" text-anchor="start" dominant-baseline="central">4 · Bindings</text><text data-type="text" data-label="Missing / rejected model: RouteBindingsSolver error: Diagnostic: ibis_asset_missing: " data-x="-5.065412" data-y="3.057635" x="246.07527999999996" y="216.5419" fill="#dc2626" font-size="8.075280000000001" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Missing / rejected model: RouteBindingsSolver error: Diagnostic: ibis_asset_missing: </text><text data-type="text" data-label="Supply IBIS bytes for models/sn74lvc1g04.ibs in ibisSources" data-x="-5.065412" data-y="2.869212" x="246.07527999999996" y="227.84727999999998" fill="#dc2626" font-size="8.075280000000001" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Supply IBIS bytes for models/sn74lvc1g04.ibs in ibisSources</text><g id="crosshair" style="display: none"><line id="crosshair-h" y1="0" y2="800" stroke="#666" stroke-width="0.5"/><line id="crosshair-v" x1="0" x2="1100" stroke="#666" stroke-width="0.5"/><text id="coordinates" font-family="monospace" font-size="12" fill="#666"></text></g><script><![CDATA[
              document.currentScript.parentElement.addEventListener('mousemove', (e) => {
                const svg = e.currentTarget;
                const rect = svg.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const crosshair = svg.getElementById('crosshair');
                const h = svg.getElementById('crosshair-h');
                const v = svg.getElementById('crosshair-v');
                const coords = svg.getElementById('coordinates');
                
                crosshair.style.display = 'block';
                h.setAttribute('x1', '0');
                h.setAttribute('x2', '1100');
                h.setAttribute('y1', y);
                h.setAttribute('y2', y);
                v.setAttribute('x1', x);
                v.setAttribute('x2', x);
                v.setAttribute('y1', '0');
                v.setAttribute('y2', '800');

                // Calculate real coordinates using inverse transformation
                const matrix = {"a":60,"c":0,"e":550,"b":0,"d":-60,"f":400};
                // Manually invert and apply the affine transform
                // Since we only use translate and scale, we can directly compute:
                // x' = (x - tx) / sx
                // y' = (y - ty) / sy
                const sx = matrix.a;
                const sy = matrix.d;
                const tx = matrix.e; 
                const ty = matrix.f;
                const realPoint = {
                  x: (x - tx) / sx,
                  y: (y - ty) / sy // Flip y back since we used negative scale
                }
                
                coords.textContent = `(${realPoint.x.toFixed(2)}, ${realPoint.y.toFixed(2)})`;
                coords.setAttribute('x', (x + 5).toString());
                coords.setAttribute('y', (y - 5).toString());
              });
              document.currentScript.parentElement.addEventListener('mouseleave', () => {
                document.currentScript.parentElement.getElementById('crosshair').style.display = 'none';
              });
            ]]></script></svg>