<svg width="1100" height="800" viewBox="0 0 1100 800" xmlns="http://www.w3.org/2000/svg"><rect width="100%" height="100%" fill="white"/><g><polyline data-points="4.98624,0.175 8.20104,0.175" data-type="line" data-label="" points="805.9057856465381,413.83180524818215 1060,413.83180524818215" fill="none" stroke="#11161c" stroke-linejoin="round" stroke-width="423.49035725576977"/></g><g><polyline data-points="-4,0 -4,0 4,0 4,0" data-type="line" data-label="DATA" points="95.6433765412583,427.66361049636424 95.6433765412583,427.66361049636424 727.9544736010116,427.66361049636424 727.9544736010116,427.66361049636424" fill="none" stroke="hsla(195, 90%, 62%, 1)" stroke-linejoin="round" stroke-width="7.903888713246918"/></g><g><polyline data-points="-4,0.35 -4,0.35 4,0.35 4,0.35" data-type="line" data-label="VICTIM" points="95.6433765412583,400.00000000000006 95.6433765412583,400.00000000000006 727.9544736010116,400.00000000000006 727.9544736010116,400.00000000000006" fill="none" stroke="hsla(15, 90%, 62%, 1)" stroke-linejoin="round" stroke-width="7.903888713246918"/></g><g><rect data-type="rect" data-label="camera" data-x="1.74852" data-y="0.175" x="40.000000000000114" y="202.08662662029724" width="1019.9999999999998" height="423.4903572557698" fill="none" stroke="none" stroke-width="0.012652"/></g><g><polygon data-type="polygon" data-label="" data-points="4.98624,-2.504 8.20104,-2.504 8.20104,2.854 4.98624,2.854" points="805.9057856465381,625.5769838760671 1060,625.5769838760671 1060,202.0866266202972 805.9057856465381,202.0866266202972" fill="none" stroke="#2c3642" stroke-width="1.2704710717673096"/></g><g><polygon data-type="polygon" data-label="unbound" data-points="-4.2,-2.7 -3.8,-2.7 -3.8,2.7 -4.2,2.7" points="79.83559911476448,641.0686057540311 111.45115396775213,641.0686057540311 111.45115396775213,214.25861523869747 79.83559911476448,214.25861523869747" fill="none" stroke="#f87171" stroke-width="2.039993676889029"/></g><g><polygon data-type="polygon" data-label="unbound" data-points="3.8,-2.7 4.2,-2.7 4.2,2.7 3.8,2.7" points="712.1466961745178,641.0686057540311 743.7622510275055,641.0686057540311 743.7622510275055,214.25861523869747 712.1466961745178,214.25861523869747" fill="none" stroke="#f87171" stroke-width="2.039993676889029"/></g><g><polygon data-type="polygon" data-label="unbound" data-points="-4.2,-3.35 -3.8,-3.35 -3.8,4.05 -4.2,4.05" points="79.83559911476448,692.443882390136 111.45115396775213,692.443882390136 111.45115396775213,107.55611760986409 79.83559911476448,107.55611760986409" fill="none" stroke="#f87171" stroke-width="2.039993676889029"/></g><g><polygon data-type="polygon" data-label="unbound" data-points="3.8,-3.35 4.2,-3.35 4.2,4.05 3.8,4.05" points="712.1466961745178,692.443882390136 743.7622510275055,692.443882390136 743.7622510275055,107.55611760986409 712.1466961745178,107.55611760986409" fill="none" stroke="#f87171" stroke-width="2.039993676889029"/></g><text data-type="text" data-label="RouteBindingsSolver error: Diagnostic: ibis_asset_missing:" data-x="5.14698" data-y="2.725408" x="818.6104963642111" y="212.25039519443573" fill="#f87171" font-size="6.352355358836547" font-family="sans-serif" text-anchor="start" dominant-baseline="central">RouteBindingsSolver error: Diagnostic: ibis_asset_missing:</text><text data-type="text" data-label="Supply IBIS bytes for models/sn74lvc1g04.ibs in ibisSources" data-x="5.14698" data-y="2.620927" x="818.6104963642111" y="220.50845716092323" fill="#f87171" font-size="6.352355358836547" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Supply IBIS bytes for models/sn74lvc1g04.ibs in ibisSources</text><g id="crosshair" style="display: none"><line id="crosshair-h" y1="0" y2="800" stroke="#666" stroke-width="0.5"/><line id="crosshair-v" x1="0" x2="1100" stroke="#666" stroke-width="0.5"/><text id="coordinates" font-family="monospace" font-size="12" fill="#666"></text></g><script><![CDATA[
              document.currentScript.parentElement.addEventListener('mousemove', (e) => {
                const svg = e.currentTarget;
                const rect = svg.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const crosshair = svg.getElementById('crosshair');
                const h = svg.getElementById('crosshair-h');
                const v = svg.getElementById('crosshair-v');
                const coords = svg.getElementById('coordinates');
                
                crosshair.style.display = 'block';
                h.setAttribute('x1', '0');
                h.setAttribute('x2', '1100');
                h.setAttribute('y1', y);
                h.setAttribute('y2', y);
                v.setAttribute('x1', x);
                v.setAttribute('x2', x);
                v.setAttribute('y1', '0');
                v.setAttribute('y2', '800');

                // Calculate real coordinates using inverse transformation
                const matrix = {"a":79.03888713246917,"c":0,"e":411.798925071135,"b":0,"d":-79.03888713246917,"f":427.66361049636424};
                // Manually invert and apply the affine transform
                // Since we only use translate and scale, we can directly compute:
                // x' = (x - tx) / sx
                // y' = (y - ty) / sy
                const sx = matrix.a;
                const sy = matrix.d;
                const tx = matrix.e; 
                const ty = matrix.f;
                const realPoint = {
                  x: (x - tx) / sx,
                  y: (y - ty) / sy // Flip y back since we used negative scale
                }
                
                coords.textContent = `(${realPoint.x.toFixed(2)}, ${realPoint.y.toFixed(2)})`;
                coords.setAttribute('x', (x + 5).toString());
                coords.setAttribute('y', (y - 5).toString());
              });
              document.currentScript.parentElement.addEventListener('mouseleave', () => {
                document.currentScript.parentElement.getElementById('crosshair').style.display = 'none';
              });
            ]]></script></svg>