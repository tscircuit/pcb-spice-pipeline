<svg width="1100" height="800" viewBox="0 0 1100 800" xmlns="http://www.w3.org/2000/svg"><rect width="100%" height="100%" fill="white"/><g><polyline data-points="47.5,50 47.5,50 72.5,50 72.5,50" data-type="line" data-label="" points="395.6423576423575,401.7982017982018 395.6423576423575,401.7982017982018 575.4625374625374,401.7982017982018 575.4625374625374,401.7982017982018" fill="none" stroke="#2563eb" stroke-linejoin="round" stroke-width="3.5964035964035967"/></g><g><polyline data-points="47.5,51.09375 47.5,51.09375 72.5,51.09375 72.5,51.09375" data-type="line" data-label="" points="395.6423576423575,393.9310689310689 395.6423576423575,393.9310689310689 575.4625374625374,393.9310689310689 575.4625374625374,393.9310689310689" fill="none" stroke="#2563eb" stroke-linejoin="round" stroke-width="3.5964035964035967"/></g><g><polyline data-points="81.25,57.8125 38.75,57.8125 38.75,65 81.25,65 81.25,57.8125" data-type="line" data-label="" points="638.3996003996003,345.60439560439556 332.7052947052946,345.60439560439556 332.7052947052946,293.9060939060939 638.3996003996003,293.9060939060939 638.3996003996003,345.60439560439556" fill="none" stroke="#16a34a" stroke-linejoin="round" stroke-width="1.4385614385614387"/></g><g><polyline data-points="81.25,35 38.75,35 38.75,65 81.25,65 81.25,35" data-type="line" data-label="" points="638.3996003996003,509.69030969030973 332.7052947052946,509.69030969030973 332.7052947052946,293.9060939060939 638.3996003996003,293.9060939060939 638.3996003996003,509.69030969030973" fill="none" stroke="#16a34a" stroke-linejoin="round" stroke-width="1.4385614385614387"/></g><g><polyline data-points="47.5,50 20,39" data-type="line" data-label="" points="395.6423576423575,401.7982017982018 197.8401598401597,480.9190809190809" fill="none" stroke="#2563eb" stroke-linejoin="round" stroke-width="0.7192807192807193"/></g><g><polyline data-points="72.5,50 28,34" data-type="line" data-label="" points="575.4625374625374,401.7982017982018 255.38261738261727,516.8831168831168" fill="none" stroke="#06b6d4" stroke-linejoin="round" stroke-width="0.7192807192807193"/></g><g><polyline data-points="47.5,51.09375 36,29" data-type="line" data-label="" points="395.6423576423575,393.9310689310689 312.9250749250748,552.8471528471529" fill="none" stroke="#2563eb" stroke-linejoin="round" stroke-width="0.7192807192807193"/></g><g><polyline data-points="72.5,51.09375 44,24" data-type="line" data-label="" points="575.4625374625374,393.9310689310689 370.46753246753235,588.8111888111888" fill="none" stroke="#06b6d4" stroke-linejoin="round" stroke-width="0.7192807192807193"/></g><g><rect data-type="rect" data-label="" data-x="60" data-y="50" x="305.7322677322676" y="266.9330669330669" width="359.64035964035975" height="269.7302697302697" fill="none" stroke="#94a3b8" stroke-width="0.13902777777777778"/></g><circle data-type="circle" data-label="" data-x="47.5" data-y="50" cx="395.6423576423575" cy="401.7982017982018" r="6.113886113886115" fill="#2563eb" stroke="#2563eb" stroke-width="0.13902777777777778"/><circle data-type="circle" data-label="" data-x="47.5" data-y="42.1875" cx="395.6423576423575" cy="457.992007992008" r="3.5964035964035967" fill="#16a34a" stroke="#16a34a" stroke-width="0.13902777777777778"/><circle data-type="circle" data-label="" data-x="47.5" data-y="57.8125" cx="395.6423576423575" cy="345.60439560439556" r="3.5964035964035967" fill="#16a34a" stroke="#16a34a" stroke-width="0.13902777777777778"/><circle data-type="circle" data-label="" data-x="72.5" data-y="50" cx="575.4625374625374" cy="401.7982017982018" r="6.113886113886115" fill="#06b6d4" stroke="#06b6d4" stroke-width="0.13902777777777778"/><circle data-type="circle" data-label="" data-x="72.5" data-y="42.1875" cx="575.4625374625374" cy="457.992007992008" r="3.5964035964035967" fill="#16a34a" stroke="#16a34a" stroke-width="0.13902777777777778"/><circle data-type="circle" data-label="" data-x="72.5" data-y="57.8125" cx="575.4625374625374" cy="345.60439560439556" r="3.5964035964035967" fill="#16a34a" stroke="#16a34a" stroke-width="0.13902777777777778"/><circle data-type="circle" data-label="" data-x="47.5" data-y="51.09375" cx="395.6423576423575" cy="393.9310689310689" r="6.113886113886115" fill="#2563eb" stroke="#2563eb" stroke-width="0.13902777777777778"/><circle data-type="circle" data-label="" data-x="47.5" data-y="40.15625" cx="395.6423576423575" cy="472.6023976023976" r="3.5964035964035967" fill="#16a34a" stroke="#16a34a" stroke-width="0.13902777777777778"/><circle data-type="circle" data-label="" data-x="47.5" data-y="62.03125" cx="395.6423576423575" cy="315.2597402597402" r="3.5964035964035967" fill="#16a34a" stroke="#16a34a" stroke-width="0.13902777777777778"/><circle data-type="circle" data-label="" data-x="72.5" data-y="51.09375" cx="575.4625374625374" cy="393.9310689310689" r="6.113886113886115" fill="#06b6d4" stroke="#06b6d4" stroke-width="0.13902777777777778"/><circle data-type="circle" data-label="" data-x="72.5" data-y="40.15625" cx="575.4625374625374" cy="472.6023976023976" r="3.5964035964035967" fill="#16a34a" stroke="#16a34a" stroke-width="0.13902777777777778"/><circle data-type="circle" data-label="" data-x="72.5" data-y="62.03125" cx="575.4625374625374" cy="315.2597402597402" r="3.5964035964035967" fill="#16a34a" stroke="#16a34a" stroke-width="0.13902777777777778"/><text data-type="text" data-label="4 · Bindings: attach IBIS buffers" data-x="2" data-y="98" x="68.36963036963024" y="56.5434565434565" fill="#0f172a" font-size="33.086913086913086" font-family="sans-serif" text-anchor="start" dominant-baseline="central">4 · Bindings: attach IBIS buffers</text><text data-type="text" data-label="Board plan · x / y in mm · y points up" data-x="2" data-y="91" x="68.36963036963024" y="106.89310689310685" fill="#334155" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Board plan · x / y in mm · y points up</text><text data-type="text" data-label="Blue: selected · Grey: neighbour" data-x="2" data-y="12" x="68.36963036963024" y="675.1248751248752" fill="#475569" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Blue: selected · Grey: neighbour</text><text data-type="text" data-label="Green: ground / rail" data-x="2" data-y="7" x="68.36963036963024" y="711.0889110889111" fill="#475569" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Green: ground / rail</text><text data-type="text" data-label="2 selected routes; 0/0 neighbour routes shown" data-x="2" data-y="2" x="68.36963036963024" y="747.052947052947" fill="#64748b" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">2 selected routes; 0/0 neighbour routes shown</text><text data-type="text" data-label="4/4 models bound · Blue: driver · Cyan: receiver · Green: rail" data-x="2" data-y="87" x="68.36963036963024" y="135.66433566433568" fill="#475569" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">4/4 models bound · Blue: driver · Cyan: receiver · Green: rail</text><text data-type="text" data-label="TX0 driver → LVC1G04_OUT_33" data-x="2" data-y="38" x="68.36963036963024" y="488.1118881118881" fill="#2563eb" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">TX0 driver → LVC1G04_OUT_33</text><text data-type="text" data-label="RX0 receiver → LVC1G04_IN_33" data-x="2" data-y="33" x="68.36963036963024" y="524.0759240759241" fill="#06b6d4" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">RX0 receiver → LVC1G04_IN_33</text><text data-type="text" data-label="TX1 driver → LVC1G04_OUT_33" data-x="2" data-y="28" x="68.36963036963024" y="560.0399600399601" fill="#2563eb" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">TX1 driver → LVC1G04_OUT_33</text><text data-type="text" data-label="RX1 receiver → LVC1G04_IN_33" data-x="2" data-y="23" x="68.36963036963024" y="596.003996003996" fill="#06b6d4" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">RX1 receiver → LVC1G04_IN_33</text><g id="crosshair" style="display: none"><line id="crosshair-h" y1="0" y2="800" stroke="#666" stroke-width="0.5"/><line id="crosshair-v" x1="0" x2="1100" stroke="#666" stroke-width="0.5"/><text id="coordinates" font-family="monospace" font-size="12" fill="#666"></text></g><script><![CDATA[
              document.currentScript.parentElement.addEventListener('mousemove', (e) => {
                const svg = e.currentTarget;
                const rect = svg.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const crosshair = svg.getElementById('crosshair');
                const h = svg.getElementById('crosshair-h');
                const v = svg.getElementById('crosshair-v');
                const coords = svg.getElementById('coordinates');
                
                crosshair.style.display = 'block';
                h.setAttribute('x1', '0');
                h.setAttribute('x2', '1100');
                h.setAttribute('y1', y);
                h.setAttribute('y2', y);
                v.setAttribute('x1', x);
                v.setAttribute('x2', x);
                v.setAttribute('y1', '0');
                v.setAttribute('y2', '800');

                // Calculate real coordinates using inverse transformation
                const matrix = {"a":7.1928071928071935,"c":0,"e":53.984015984015855,"b":0,"d":-7.1928071928071935,"f":761.4385614385615};
                // Manually invert and apply the affine transform
                // Since we only use translate and scale, we can directly compute:
                // x' = (x - tx) / sx
                // y' = (y - ty) / sy
                const sx = matrix.a;
                const sy = matrix.d;
                const tx = matrix.e; 
                const ty = matrix.f;
                const realPoint = {
                  x: (x - tx) / sx,
                  y: (y - ty) / sy // Flip y back since we used negative scale
                }
                
                coords.textContent = `(${realPoint.x.toFixed(2)}, ${realPoint.y.toFixed(2)})`;
                coords.setAttribute('x', (x + 5).toString());
                coords.setAttribute('y', (y - 5).toString());
              });
              document.currentScript.parentElement.addEventListener('mouseleave', () => {
                document.currentScript.parentElement.getElementById('crosshair').style.display = 'none';
              });
            ]]></script></svg>