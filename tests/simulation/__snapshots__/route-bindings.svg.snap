<svg width="1100" height="800" viewBox="0 0 1100 800" xmlns="http://www.w3.org/2000/svg"><rect width="100%" height="100%" fill="white"/><g><polyline data-points="-8,-6 8,-6 8,6 -8,6 -8,-6" data-type="line" data-label="" points="70,760 1030,760 1030,40 70,40 70,760" fill="none" stroke="#64748b" stroke-linejoin="round" stroke-width="2.4"/></g><g><polyline data-points="6.8,-4.8 -6.8,-4.8 -6.8,4.8 6.8,4.8 6.8,-4.8" data-type="line" data-label="" points="958,688 142,688 142,112 958,112 958,688" fill="none" stroke="#7fa7d690" stroke-linejoin="round" stroke-width="1.44"/></g><g><polyline data-points="6.8,2.5 -6.8,2.5 -6.8,4.8 6.8,4.8 6.8,2.5" data-type="line" data-label="" points="958,250 142,250 142,112 958,112 958,250" fill="none" stroke="#e8a07a90" stroke-linejoin="round" stroke-width="1.44"/></g><g><polyline data-points="-4,0 -4,0 4,0 4,0" data-type="line" data-label="" points="310,400 310,400 790,400 790,400" fill="none" stroke="#e8a07ad0" stroke-linejoin="round" stroke-width="6"/></g><g><polyline data-points="-4,0.35 -4,0.35 4,0.35 4,0.35" data-type="line" data-label="" points="310,379 310,379 790,379 790,379" fill="none" stroke="#e8a07ad0" stroke-linejoin="round" stroke-width="6"/></g><g><polyline data-points="-4,0 -4,0" data-type="line" data-label="" points="310,400 310,400" fill="none" stroke="#1d4ed8" stroke-linejoin="round" stroke-width="6"/></g><g><polyline data-points="-4,0 4,0" data-type="line" data-label="" points="310,400 790,400" fill="none" stroke="#1d4ed8" stroke-linejoin="round" stroke-width="6"/></g><g><polyline data-points="4,0 4,0" data-type="line" data-label="" points="790,400 790,400" fill="none" stroke="#1d4ed8" stroke-linejoin="round" stroke-width="6"/></g><g><polyline data-points="-4,0.35 -4,0.35" data-type="line" data-label="" points="310,379 310,379" fill="none" stroke="#1d4ed8" stroke-linejoin="round" stroke-width="6"/></g><g><polyline data-points="-4,0.35 4,0.35" data-type="line" data-label="" points="310,379 790,379" fill="none" stroke="#1d