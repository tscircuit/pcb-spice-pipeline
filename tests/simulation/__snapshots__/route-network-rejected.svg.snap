<svg width="1100" height="800" viewBox="0 0 1100 800" xmlns="http://www.w3.org/2000/svg"><rect width="100%" height="100%" fill="white"/><g><polyline data-points="47.5,50 47.5,50 72.5,50 72.5,50" data-type="line" data-label="" points="292.77777777777777,384.72222222222223 292.77777777777777,384.72222222222223 431.6666666666667,384.72222222222223 431.6666666666667,384.72222222222223" fill="none" stroke="#2563eb" stroke-linejoin="round" stroke-width="2.7777777777777777"/></g><g><polyline data-points="47.5,51.09375 47.5,51.09375 72.5,51.09375 72.5,51.09375" data-type="line" data-label="" points="292.77777777777777,378.64583333333337 292.77777777777777,378.64583333333337 431.6666666666667,378.64583333333337 431.6666666666667,378.64583333333337" fill="none" stroke="#2563eb" stroke-linejoin="round" stroke-width="2.7777777777777777"/></g><g><polyline data-points="81.25,57.8125 38.75,57.8125 38.75,65 81.25,65 81.25,57.8125" data-type="line" data-label="" points="480.27777777777777,341.31944444444446 244.16666666666669,341.31944444444446 244.16666666666669,301.3888888888889 480.27777777777777,301.3888888888889 480.27777777777777,341.31944444444446" fill="none" stroke="#16a34a" stroke-linejoin="round" stroke-width="1.1111111111111112"/></g><g><polyline data-points="81.25,35 38.75,35 38.75,65 81.25,65 81.25,35" data-type="line" data-label="" points="480.27777777777777,468.05555555555554 244.16666666666669,468.05555555555554 244.16666666666669,301.3888888888889 480.27777777777777,301.3888888888889 480.27777777777777,468.05555555555554" fill="none" stroke="#16a34a" stroke-linejoin="round" stroke-width="1.1111111111111112"/></g><g><polyline data-points="47.5,50 72.5,50" data-type="line" data-label="" points="292.77777777777777,384.72222222222223 431.6666666666667,384.72222222222223" fill="none" stroke="#2563eb" stroke-linejoin="round" stroke-width="2.5"/></g><g><polyline data-points="47.5,51.09375 72.5,51.09375" data-type="line" data-label="" points="292.77777777777777,378.64583333333337 431.6666666666667,378.64583333333337" fill="none" stroke="#0891b2" stroke-linejoin="round" stroke-width="2.5"/></g><g><rect data-type="rect" data-label="" data-x="60" data-y="50" x="223.33333333333331" y="280.55555555555554" width="277.7777777777778" height="208.33333333333337" fill="none" stroke="#94a3b8" stroke-width="0.18"/></g><text data-type="text" data-label="5 · Network: build a coupled ladder" data-x="2" data-y="98" x="40.00000000000003" y="118.05555555555554" fill="#0f172a" font-size="25.555555555555554" font-family="sans-serif" text-anchor="start" dominant-baseline="central">5 · Network: build a coupled ladder</text><text data-type="text" data-label="Board plan · x / y in mm · y points up" data-x="2" data-y="91" x="40.00000000000003" y="156.94444444444446" fill="#334155" font-size="20" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Board plan · x / y in mm · y points up</text><text data-type="text" data-label="2 selected routes; 0/0 neighbour routes shown" data-x="2" data-y="2" x="40.00000000000003" y="651.3888888888889" fill="#64748b" font-size="20" font-family="sans-serif" text-anchor="start" dominant-baseline="central">2 selected routes; 0/0 neighbour routes shown</text><text data-type="text" data-label="TX0.Y → RX0.A" data-x="2" data-y="28" x="40.00000000000003" y="506.94444444444446" fill="#2563eb" font-size="20" font-family="sans-serif" text-anchor="start" dominant-baseline="central">TX0.Y → RX0.A</text><text data-type="text" data-label="TX1.Y → RX1.A" data-x="62" data-y="28" x="373.33333333333337" y="506.94444444444446" fill="#0891b2" font-size="20" font-family="sans-serif" text-anchor="start" dominant-baseline="central">TX1.Y → RX1.A</text><text data-type="text" data-label="Net colours above · Orange: via" data-x="2" data-y="12" x="40.00000000000003" y="595.8333333333334" fill="#475569" font-size="20" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Net colours above · Orange: via</text><text data-type="text" data-label="Magenta: join · Green: pour" data-x="2" data-y="7" x="40.00000000000003" y="623.6111111111111" fill="#475569" font-size="20" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Magenta: join · Green: pour</text><text data-type="text" data-label="0 cells · max cell delay 0.00 ps" data-x="2" data-y="87" x="40.00000000000003" y="179.16666666666669" fill="#a16207" font-size="20" font-family="sans-serif" text-anchor="start" dominant-baseline="central">0 cells · max cell delay 0.00 ps</text><text data-type="text" data-label="Amber: cells · Purple: oblique encounters" data-x="2" data-y="81" x="40.00000000000003" y="212.5" fill="#475569" font-size="20" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Amber: cells · Purple: oblique encounters</text><text data-type="text" data-label="Orange rings: vias" data-x="2" data-y="76" x="40.00000000000003" y="240.27777777777777" fill="#475569" font-size="20" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Orange rings: vias</text><text data-type="text" data-label="0/0 node ticks shown · pending oblique encounters · native not run" data-x="2" data-y="71" x="40.00000000000003" y="268.05555555555554" fill="#64748b" font-size="20" font-family="sans-serif" text-anchor="start" dominant-baseline="central">0/0 node ticks shown · pending oblique encounters · native not run</text><text data-type="text" data-label="Input: 4 bound IBIS models · 3 probes" data-x="2" data-y="-4" x="40.00000000000003" y="684.7222222222222" fill="#475569" font-size="20" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Input: 4 bound IBIS models · 3 probes</text><text data-type="text" data-label="Network rejected: Route ladder requires 1835 cells; exceeds modest-memory limit of 10" data-x="2" data-y="70" x="40.00000000000003" y="273.61111111111114" fill="#dc2626" font-size="20" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Network rejected: Route ladder requires 1835 cells; exceeds modest-memory limit of 10</text><text data-type="text" data-label="24" data-x="2" data-y="67" x="40.00000000000003" y="290.27777777777777" fill="#dc2626" font-size="20" font-family="sans-serif" text-anchor="start" dominant-baseline="central">24</text><g id="crosshair" style="display: none"><line id="crosshair-h" y1="0" y2="800" stroke="#666" stroke-width="0.5"/><line id="crosshair-v" x1="0" x2="1100" stroke="#666" stroke-width="0.5"/><text id="coordinates" font-family="monospace" font-size="12" fill="#666"></text></g><script><![CDATA[
              document.currentScript.parentElement.addEventListener('mousemove', (e) => {
                const svg = e.currentTarget;
                const rect = svg.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const crosshair = svg.getElementById('crosshair');
                const h = svg.getElementById('crosshair-h');
                const v = svg.getElementById('crosshair-v');
                const coords = svg.getElementById('coordinates');
                
                crosshair.style.display = 'block';
                h.setAttribute('x1', '0');
                h.setAttribute('x2', '1100');
                h.setAttribute('y1', y);
                h.setAttribute('y2', y);
                v.setAttribute('x1', x);
                v.setAttribute('x2', x);
                v.setAttribute('y1', '0');
                v.setAttribute('y2', '800');

                // Calculate real coordinates using inverse transformation
                const matrix = {"a":5.555555555555555,"c":0,"e":28.888888888888914,"b":0,"d":-5.555555555555555,"f":662.5};
                // Manually invert and apply the affine transform
                // Since we only use translate and scale, we can directly compute:
                // x' = (x - tx) / sx
                // y' = (y - ty) / sy
                const sx = matrix.a;
                const sy = matrix.d;
                const tx = matrix.e; 
                const ty = matrix.f;
                const realPoint = {
                  x: (x - tx) / sx,
                  y: (y - ty) / sy // Flip y back since we used negative scale
                }
                
                coords.textContent = `(${realPoint.x.toFixed(2)}, ${realPoint.y.toFixed(2)})`;
                coords.setAttribute('x', (x + 5).toString());
                coords.setAttribute('y', (y - 5).toString());
              });
              document.currentScript.parentElement.addEventListener('mouseleave', () => {
                document.currentScript.parentElement.getElementById('crosshair').style.display = 'none';
              });
            ]]></script></svg>