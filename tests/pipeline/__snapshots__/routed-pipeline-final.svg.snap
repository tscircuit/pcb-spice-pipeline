ze="6.236942675159236" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Purple thickness = coupling · 2 conductors · self values above</text><text data-type="text" data-label="5 · Transient: ngspice samples · candidate-unqualified" data-x="2" data-y="198" x="161.10828025477704" y="45.13630573248406" fill="#a16207" font-size="10.272611464968152" font-family="sans-serif" text-anchor="start" dominant-baseline="central">5 · Transient: ngspice samples · candidate-unqualified</text><text data-type="text" data-label="-0.4 V" data-x="2" data-y="138.582577" x="161.10828025477704" y="263.1263417070064" fill="#dc2626" font-size="6.603821656050956" font-family="sans-serif" text-anchor="start" dominant-baseline="central">-0.4 V</text><text data-type="text" data-label="0 V" data-x="2" data-y="143.119782" x="161.10828025477704" y="246.48029024203822" fill="#64748b" font-size="6.603821656050956" font-family="sans-serif" text-anchor="start" dominant-baseline="central">0 V</text><text data-type="text" data-label="1 V" data-x="2" data-y="154.462795" x="161.10828025477704" y="204.86515974522297" fill="#64748b" font-size="6.603821656050956" font-family="sans-serif" text-anchor="start" dominant-baseline="central">1 V</text><text data-type="text" data-label="1.9 V" data-x="2" data-y="164.671506" x="161.10828025477704" y="167.41154486624202" fill="#dc2626" font-size="6.603821656050956" font-family="sans-serif" text-anchor="start" dominant-baseline="central">1.9 V</text><text data-type="text" data-label="0.00" data-x="13" data-y="130" x="201.46496815286622" y="294.6140127388535" fill="#64748b" font-size="6.603821656050956" font-family="sans-serif" text-anchor="start" dominant-baseline="central">0.00</text><text data-type="text" data-label="1.00" data-x="60.5" data-y="130" x="375.73248407643314" y="294.6140127388535" fill="#64748b" font-size="6.603821656050956" font-family="sans-serif" text-anchor="start" dominant-baseline="central">1.00</text><text data-type="text" data-label="2.00" data-x="108" data-y="130" x="550" y="294.6140127388535" fill="#64748b" font-size="6.603821656050956" font-family="sans-serif" text-anchor="start" dominant-baseline="central">2.00</text><text data-type="text" data-label="3.00" data-x="155.5" data-y="130" x="724.2675159235669" y="294.6140127388535" fill="#64748b" font-size="6.603821656050956" font-family="sans-serif" text-anchor="start" dominant-baseline="central">3.00</text><text data-type="text" data-label="4.00" data-x="203" data-y="130" x="898.5350318471337" y="294.6140127388535" fill="#64748b" font-size="6.603821656050956" font-family="sans-serif" text-anchor="start" dominant-baseline="central">4.00</text><text data-type="text" data-label="Voltage (V) · Red dashed: 1.9 V / −0.4 V limits" data-x="2" data-y="189" x="161.10828025477704" y="78.1554140127389" fill="#475569" font-size="6.970700636942675" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Voltage (V) · Red dashed: 1.9 V / −0.4 V limits</text><text data-type="text" data-label="Time (ns)" data-x="96" data-y="124" x="505.97452229299364" y="316.6267515923567" fill="#475569" font-size="7.337579617834395" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Time (ns)</text><text data-type="text" data-label="DATA_0 · RX far" data-x="14" data-y="192.5" x="205.13375796178343" y="65.31464968152864" fill="#2563eb" font-size="6.236942675159236" font-family="sans-serif" text-anchor="start" dominant-baseline="central">DATA_0 · RX far</text><text data-type="text" data-label="VICTIM_0 · RX far" data-x="46" data-y="192.5" x="322.5350318471337" y="65.31464968152864" fill="#9333ea" font-size="6.236942675159236" font-family="sans-serif" text-anchor="start" dominant-baseline="central">VICTIM_0 · RX far</text><text data-type="text" data-label="VICTIM_1 · TX near" data-x="78" data-y="192.5" x="439.9363057324841" y="65.31464968152864" fill="#9333ea" font-size="6.236942675159236" font-family="sans-serif" text-anchor="start" dominant-baseline="central">VICTIM_1 · TX near</text><g id="crosshair" style="display: none"><line id="crosshair-h" y1="0" y2="800" stroke="#666" stroke-width="0.5"/><line id="crosshair-v" x1="0" x2="1100" stroke="#666" stroke-width="0.5"/><text id="coordinates" font-family="monospace" font-size="12" fill="#666"></text></g><script><![CDATA[
              document.currentScript.parentElement.addEventListener('mousemove', (e) => {
                const svg = e.currentTarget;
                const rect = svg.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const crosshair = svg.getElementById('crosshair');
                const h = svg.getElementById('crosshair-h');
                const v = svg.getElementById('crosshair-v');
                const coords = svg.getElementById('coordinates');
                
                crosshair.style.display = 'block';
                h.setAttribute('x1', '0');
                h.setAttribute('x2', '1100');
                h.setAttribute('y1', y);
                h.setAttribute('y2', y);
                v.setAttribute('x1', x);
                v.setAttribute('x2', x);
                v.setAttribute('y1', '0');
                v.setAttribute('y2', '800');

                // Calculate real coordinates using inverse transformation
                const matrix = {"a":3.6687898089171975,"c":0,"e":153.77070063694265,"b":0,"d":-3.6687898089171975,"f":771.5566878980892};
                // Manually invert and apply the affine transform
                // Since we only use translate and scale, we can directly compute:
                // x' = (x - tx) / sx
                // y' = (y - ty) / sy
                const sx = matrix.a;
                const sy = matrix.d;
                const tx = matrix.e; 
                const ty = matrix.f;
                const realPoint = {
                  x: (x - tx) / sx,
                  y: (y - ty) / sy // Flip y back since we used negative scale
                }
                
                coords.textContent = `(${realPoint.x.toFixed(2)}, ${realPoint.y.toFixed(2)})`;
                coords.setAttribute('x', (x + 5).toString());
                coords.setAttribute('y', (y - 5).toString());
              });
              document.currentScript.parentElement.addEventListener('mouseleave', () => {
                document.currentScript.parentElement.getElementById('crosshair').style.display = 'none';
              });
            ]]></script></svg>