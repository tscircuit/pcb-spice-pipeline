-x="132" data-y="1" x="485.5046364735923" y="695.5751915065179" fill="#7e22ce" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Strongest pair 0↔1: Cm 24.19 pF/m · Lm 434.88 nH/m · k=0.501</text><text data-type="text" data-label="Purple thickness = coupling · 2 conductors · self values above" data-x="132" data-y="-4" x="485.5046364735923" y="712.7099852170406" fill="#64748b" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Purple thickness = coupling · 2 conductors · self values above</text><text data-type="text" data-label="5 · Transient: ngspice samples · candidate-unqualified" data-x="2" data-y="178" x="40.00000000000002" y="89.00349415401149" fill="#a16207" font-size="15.764010213680956" font-family="sans-serif" text-anchor="start" dominant-baseline="central">5 · Transient: ngspice samples · candidate-unqualified</text><text data-type="text" data-label="-0.4 V" data-x="2" data-y="121.666062" x="40.00000000000002" y="282.0575754602875" fill="#dc2626" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">-0.4 V</text><text data-type="text" data-label="0 V" data-x="2" data-y="125.295826" x="40.00000000000002" y="269.6185239887111" fill="#64748b" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">0 V</text><text data-type="text" data-label="1 V" data-x="2" data-y="134.370236" x="40.00000000000002" y="238.52089530977014" fill="#64748b" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">1 V</text><text data-type="text" data-label="1.9 V" data-x="2" data-y="142.537205" x="40.00000000000002" y="210.53302949872324" fill="#dc2626" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">1.9 V</text><text data-type="text" data-label="0.00" data-x="13" data-y="113" x="77.69654616315015" y="311.75581239080765" fill="#64748b" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">0.00</text><text data-type="text" data-label="1.00" data-x="82.5" data-y="113" x="315.87017873941676" y="311.75581239080765" fill="#64748b" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">1.00</text><text data-type="text" data-label="2.00" data-x="152" data-y="113" x="554.0438113156835" y="311.75581239080765" fill="#64748b" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">2.00</text><text data-type="text" data-label="3.00" data-x="221.5" data-y="113" x="792.2174438919501" y="311.75581239080765" fill="#64748b" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">3.00</text><text data-type="text" data-label="4.00" data-x="291" data-y="113" x="1030.3910764682169" y="311.75581239080765" fill="#64748b" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">4.00</text><text data-type="text" data-label="Voltage (V) · Red dashed: 1.9 V / −0.4 V limits" data-x="2" data-y="164" x="40.00000000000002" y="136.98091654347525" fill="#475569" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Voltage (V) · Red dashed: 1.9 V / −0.4 V limits</text><text data-type="text" data-label="Time (ns)" data-x="140" data-y="108" x="512.9203064104288" y="328.89060610133043" fill="#475569" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Time (ns)</text><text data-type="text" data-label="DATA_0 · RX far" data-x="14" data-y="172" x="81.12350490525469" y="109.56524660663888" fill="#2563eb" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">DATA_0 · RX far</text><text data-type="text" data-label="VICTIM_0 · RX far" data-x="60" data-y="172" x="238.76360704206428" y="109.56524660663888" fill="#9333ea" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">VICTIM_0 · RX far</text><text data-type="text" data-label="VICTIM_1 · TX near" data-x="106" data-y="172" x="396.40370917887384" y="109.56524660663888" fill="#9333ea" font-size="12.337051471576402" font-family="sans-serif" text-anchor="start" dominant-baseline="central">VICTIM_1 · TX near</text><g id="crosshair" style="display: none"><line id="crosshair-h" y1="0" y2="800" stroke="#666" stroke-width="0.5"/><line id="crosshair-v" x1="0" x2="1100" stroke="#666" stroke-width="0.5"/><text id="coordinates" font-family="monospace" font-size="12" fill="#666"></text></g><script><![CDATA[
              document.currentScript.parentElement.addEventListener('mousemove', (e) => {
                const svg = e.currentTarget;
                const rect = svg.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const crosshair = svg.getElementById('crosshair');
                const h = svg.getElementById('crosshair-h');
                const v = svg.getElementById('crosshair-v');
                const coords = svg.getElementById('coordinates');
                
                crosshair.style.display = 'block';
                h.setAttribute('x1', '0');
                h.setAttribute('x2', '1100');
                h.setAttribute('y1', y);
                h.setAttribute('y2', y);
                v.setAttribute('x1', x);
                v.setAttribute('x2', x);
                v.setAttribute('y1', '0');
                v.setAttribute('y2', '800');

                // Calculate real coordinates using inverse transformation
                const matrix = {"a":3.426958742104556,"c":0,"e":33.14608251579091,"b":0,"d":-3.426958742104556,"f":699.0021502486225};
                // Manually invert and apply the affine transform
                // Since we only use translate and scale, we can directly compute:
                // x' = (x - tx) / sx
                // y' = (y - ty) / sy
                const sx = matrix.a;
                const sy = matrix.d;
                const tx = matrix.e; 
                const ty = matrix.f;
                const realPoint = {
                  x: (x - tx) / sx,
                  y: (y - ty) / sy // Flip y back since we used negative scale
                }
                
                coords.textContent = `(${realPoint.x.toFixed(2)}, ${realPoint.y.toFixed(2)})`;
                coords.setAttribute('x', (x + 5).toString());
                coords.setAttribute('y', (y - 5).toString());
              });
              document.currentScript.parentElement.addEventListener('mouseleave', () => {
                document.currentScript.parentElement.getElementById('crosshair').style.display = 'none';
              });
            ]]></script></svg>