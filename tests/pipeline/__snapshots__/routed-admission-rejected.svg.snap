<svg width="1100" height="800" viewBox="0 0 1100 800" xmlns="http://www.w3.org/2000/svg"><rect width="100%" height="100%" fill="white"/><g><polyline data-points="47.5,50 47.5,50 72.5,50 72.5,50" data-type="line" data-label="" points="292.77777777777777,401.38888888888886 292.77777777777777,401.38888888888886 431.6666666666667,401.38888888888886 431.6666666666667,401.38888888888886" fill="none" stroke="#cbd5e1" stroke-linejoin="round" stroke-width="0.5555555555555556"/></g><g><polyline data-points="47.5,51.09375 47.5,51.09375 72.5,51.09375 72.5,51.09375" data-type="line" data-label="" points="292.77777777777777,395.3125 292.77777777777777,395.3125 431.6666666666667,395.3125 431.6666666666667,395.3125" fill="none" stroke="#cbd5e1" stroke-linejoin="round" stroke-width="0.5555555555555556"/></g><g><polyline data-points="81.25,57.8125 38.75,57.8125 38.75,65 81.25,65 81.25,57.8125" data-type="line" data-label="" points="480.27777777777777,357.9861111111111 244.16666666666669,357.9861111111111 244.16666666666669,318.05555555555554 480.27777777777777,318.05555555555554 480.27777777777777,357.9861111111111" fill="none" stroke="#16a34a" stroke-linejoin="round" stroke-width="1.1111111111111112"/></g><g><polyline data-points="81.25,35 38.75,35 38.75,65 81.25,65 81.25,35" data-type="line" data-label="" points="480.27777777777777,484.7222222222222 244.16666666666669,484.7222222222222 244.16666666666669,318.05555555555554 480.27777777777777,318.05555555555554 480.27777777777777,484.7222222222222" fill="none" stroke="#16a34a" stroke-linejoin="round" stroke-width="1.1111111111111112"/></g><g><polyline data-points="16,16 84,84" data-type="line" data-label="" points="117.7777777777778,590.2777777777777 495.55555555555554,212.5" fill="none" stroke="#dc2626" stroke-linejoin="round" stroke-width="2.7777777777777777"/></g><g><rect data-type="rect" data-label="" data-x="60" data-y="50" x="223.33333333333331" y="297.2222222222222" width="277.7777777777778" height="208.33333333333337" fill="none" stroke="#94a3b8" stroke-width="0.18"/></g><text data-type="text" data-label="0 · Admission: choose signal copper" data-x="2" data-y="98" x="40.00000000000003" y="134.72222222222217" fill="#0f172a" font-size="25.555555555555554" font-family="sans-serif" text-anchor="start" dominant-baseline="central">0 · Admission: choose signal copper</text><text data-type="text" data-label="Board plan · x / y in mm · y points up" data-x="2" data-y="91" x="40.00000000000003" y="173.6111111111111" fill="#334155" font-size="20" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Board plan · x / y in mm · y points up</text><text data-type="text" data-label="Blue: selected · Grey: neighbour" data-x="2" data-y="12" x="40.00000000000003" y="612.5" fill="#475569" font-size="20" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Blue: selected · Grey: neighbour</text><text data-type="text" data-label="Green: ground / rail" data-x="2" data-y="7" x="40.00000000000003" y="640.2777777777777" fill="#475569" font-size="20" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Green: ground / rail</text><text data-type="text" data-label="0 selected routes; 2/2 neighbour routes shown" data-x="2" data-y="2" x="40.00000000000003" y="668.0555555555555" fill="#64748b" font-size="20" font-family="sans-serif" text-anchor="start" dominant-baseline="central">0 selected routes; 2/2 neighbour routes shown</text><text data-type="text" data-label="0 endpoints · scope radius 0 mm · 0 admitted blocks" data-x="2" data-y="87" x="40.00000000000003" y="195.83333333333331" fill="#334155" font-size="20" font-family="sans-serif" text-anchor="start" dominant-baseline="central">0 endpoints · scope radius 0 mm · 0 admitted blocks</text><text data-type="text" data-label="Rejected: RoutedAdmissionSolver error: Error: Copper scope distance must be in (0,32]" data-x="2" data-y="83" x="40.00000000000003" y="218.05555555555554" fill="#dc2626" font-size="20" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Rejected: RoutedAdmissionSolver error: Error: Copper scope distance must be in (0,32]</text><text data-type="text" data-label=" mm" data-x="2" data-y="80" x="40.00000000000003" y="234.72222222222217" fill="#dc2626" font-size="20" font-family="sans-serif" text-anchor="start" dominant-baseline="central"> mm</text><g id="crosshair" style="display: none"><line id="crosshair-h" y1="0" y2="800" stroke="#666" stroke-width="0.5"/><line id="crosshair-v" x1="0" x2="1100" stroke="#666" stroke-width="0.5"/><text id="coordinates" font-family="monospace" font-size="12" fill="#666"></text></g><script><![CDATA[
              document.currentScript.parentElement.addEventListener('mousemove', (e) => {
                const svg = e.currentTarget;
                const rect = svg.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const crosshair = svg.getElementById('crosshair');
                const h = svg.getElementById('crosshair-h');
                const v = svg.getElementById('crosshair-v');
                const coords = svg.getElementById('coordinates');
                
                crosshair.style.display = 'block';
                h.setAttribute('x1', '0');
                h.setAttribute('x2', '1100');
                h.setAttribute('y1', y);
                h.setAttribute('y2', y);
                v.setAttribute('x1', x);
                v.setAttribute('x2', x);
                v.setAttribute('y1', '0');
                v.setAttribute('y2', '800');

                // Calculate real coordinates using inverse transformation
                const matrix = {"a":5.555555555555555,"c":0,"e":28.888888888888914,"b":0,"d":-5.555555555555555,"f":679.1666666666666};
                // Manually invert and apply the affine transform
                // Since we only use translate and scale, we can directly compute:
                // x' = (x - tx) / sx
                // y' = (y - ty) / sy
                const sx = matrix.a;
                const sy = matrix.d;
                const tx = matrix.e; 
                const ty = matrix.f;
                const realPoint = {
                  x: (x - tx) / sx,
                  y: (y - ty) / sy // Flip y back since we used negative scale
                }
                
                coords.textContent = `(${realPoint.x.toFixed(2)}, ${realPoint.y.toFixed(2)})`;
                coords.setAttribute('x', (x + 5).toString());
                coords.setAttribute('y', (y - 5).toString());
              });
              document.currentScript.parentElement.addEventListener('mouseleave', () => {
                document.currentScript.parentElement.getElementById('crosshair').style.display = 'none';
              });
            ]]></script></svg>