<svg width="1100" height="800" viewBox="0 0 1100 800" xmlns="http://www.w3.org/2000/svg"><rect width="100%" height="100%" fill="white"/><g><polyline data-points="47.5,50 47.5,50 72.5,50 72.5,50" data-type="line" data-label="" points="527.7022977022976,401.7982017982018 527.7022977022976,401.7982017982018 707.5224775224775,401.7982017982018 707.5224775224775,401.7982017982018" fill="none" stroke="#cbd5e1" stroke-linejoin="round" stroke-width="0.7192807192807193"/></g><g><polyline data-points="47.5,51.09375 47.5,51.09375 72.5,51.09375 72.5,51.09375" data-type="line" data-label="" points="527.7022977022976,393.9310689310689 527.7022977022976,393.9310689310689 707.5224775224775,393.9310689310689 707.5224775224775,393.9310689310689" fill="none" stroke="#cbd5e1" stroke-linejoin="round" stroke-width="0.7192807192807193"/></g><g><polyline data-points="81.25,57.8125 38.75,57.8125 38.75,65 81.25,65 81.25,57.8125" data-type="line" data-label="" points="770.4595404595404,345.60439560439556 464.7652347652347,345.60439560439556 464.7652347652347,293.9060939060939 770.4595404595404,293.9060939060939 770.4595404595404,345.60439560439556" fill="none" stroke="#16a34a" stroke-linejoin="round" stroke-width="1.4385614385614387"/></g><g><polyline data-points="81.25,35 38.75,35 38.75,65 81.25,65 81.25,35" data-type="line" data-label="" points="770.4595404595404,509.69030969030973 464.7652347652347,509.69030969030973 464.7652347652347,293.9060939060939 770.4595404595404,293.9060939060939 770.4595404595404,509.69030969030973" fill="none" stroke="#16a34a" stroke-linejoin="round" stroke-width="1.4385614385614387"/></g><g><rect data-type="rect" data-label="" data-x="60" data-y="50" x="437.7922077922077" y="266.9330669330669" width="359.64035964035975" height="269.7302697302697" fill="none" stroke="#94a3b8" stroke-width="0.13902777777777778"/></g><text data-type="text" data-label="0 · Initial board" data-x="2" data-y="98" x="200.42957042957036" y="56.5434565434565" fill="#0f172a" font-size="33.086913086913086" font-family="sans-serif" text-anchor="start" dominant-baseline="central">0 · Initial board</text><text data-type="text" data-label="Board plan · x / y in mm · y points up" data-x="2" data-y="91" x="200.42957042957036" y="106.89310689310685" fill="#334155" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Board plan · x / y in mm · y points up</text><text data-type="text" data-label="Blue: selected · Grey: neighbour" data-x="2" data-y="12" x="200.42957042957036" y="675.1248751248752" fill="#475569" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Blue: selected · Grey: neighbour</text><text data-type="text" data-label="Green: ground / rail" data-x="2" data-y="7" x="200.42957042957036" y="711.0889110889111" fill="#475569" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Green: ground / rail</text><text data-type="text" data-label="0 selected routes; 2/2 neighbour routes shown" data-x="2" data-y="2" x="200.42957042957036" y="747.052947052947" fill="#64748b" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">0 selected routes; 2/2 neighbour routes shown</text><g id="crosshair" style="display: none"><line id="crosshair-h" y1="0" y2="800" stroke="#666" stroke-width="0.5"/><line id="crosshair-v" x1="0" x2="1100" stroke="#666" stroke-width="0.5"/><text id="coordinates" font-family="monospace" font-size="12" fill="#666"></text></g><script><![CDATA[
              document.currentScript.parentElement.addEventListener('mousemove', (e) => {
                const svg = e.currentTarget;
                const rect = svg.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const crosshair = svg.getElementById('crosshair');
                const h = svg.getElementById('crosshair-h');
                const v = svg.getElementById('crosshair-v');
                const coords = svg.getElementById('coordinates');
                
                crosshair.style.display = 'block';
                h.setAttribute('x1', '0');
                h.setAttribute('x2', '1100');
                h.setAttribute('y1', y);
                h.setAttribute('y2', y);
                v.setAttribute('x1', x);
                v.setAttribute('x2', x);
                v.setAttribute('y1', '0');
                v.setAttribute('y2', '800');

                // Calculate real coordinates using inverse transformation
                const matrix = {"a":7.1928071928071935,"c":0,"e":186.04395604395597,"b":0,"d":-7.1928071928071935,"f":761.4385614385615};
                // Manually invert and apply the affine transform
                // Since we only use translate and scale, we can directly compute:
                // x' = (x - tx) / sx
                // y' = (y - ty) / sy
                const sx = matrix.a;
                const sy = matrix.d;
                const tx = matrix.e; 
                const ty = matrix.f;
                const realPoint = {
                  x: (x - tx) / sx,
                  y: (y - ty) / sy // Flip y back since we used negative scale
                }
                
                coords.textContent = `(${realPoint.x.toFixed(2)}, ${realPoint.y.toFixed(2)})`;
                coords.setAttribute('x', (x + 5).toString());
                coords.setAttribute('y', (y - 5).toString());
              });
              document.currentScript.parentElement.addEventListener('mouseleave', () => {
                document.currentScript.parentElement.getElementById('crosshair').style.display = 'none';
              });
            ]]></script></svg>