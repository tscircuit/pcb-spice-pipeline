<svg width="1100" height="800" viewBox="0 0 1100 800" xmlns="http://www.w3.org/2000/svg"><rect width="100%" height="100%" fill="white"/><g><polyline data-points="136,42.155126 292,42.155126" data-type="line" data-label="" points="65.5,432.47982175 1060,432.47982175" fill="none" stroke="#16a34a" stroke-linejoin="round" stroke-width="3.1875"/></g><g><polyline data-points="172,68.370878 256,68.370878" data-type="line" data-label="k=0.501" points="295,265.35440274999996 830.5,265.35440274999996" fill="none" stroke="#9333ea" stroke-linejoin="round" stroke-width="10.543128"/></g><g><rect data-type="rect" data-label="" data-x="214" data-y="41.077563" x="65.5" y="432.47982175000004" width="994.5" height="13.738928249999958" fill="#fef3c7" stroke="black" stroke-width="0.1568627450980392"/></g><g><rect data-type="rect" data-label="" data-x="214" data-y="43.971068" x="65.5" y="409.3265644375" width="994.5" height="23.15325412499999" fill="#fef3c7" stroke="black" stroke-width="0.1568627450980392"/></g><g><rect data-type="rect" data-label="" data-x="214" data-y="46.497127" x="65.5" y="400.272563125" width="994.5" height="9.054004500000019" fill="#fef3c7" stroke="black" stroke-width="0.1568627450980392"/></g><g><rect data-type="rect" data-label="" data-x="214" data-y="53.685439" x="65.5" y="317.675589625" width="994.5" height="82.59697349999999" fill="#fef3c7" stroke="black" stroke-width="0.1568627450980392"/></g><g><rect data-type="rect" data-label="" data-x="214" data-y="60.873751" x="65.5" y="308.621585125" width="994.5" height="9.054004500000019" fill="#fef3c7" stroke="black" stroke-width="0.1568627450980392"/></g><g><rect data-type="rect" data-label="" data-x="214" data-y="63.39981" x="65.5" y="285.4683341875" width="994.5" height="23.153254124999933" fill="#fef3c7" stroke="black" stroke-width="0.1568627450980392"/></g><g><rect data-type="rect" data-label="" data-x="214" data-y="67.107876" x="65.5" y="261.34375" width="994.5" height="24.12458099999992" fill="#cffafe" stroke="black" stroke-width="0.1568627450980392"/></g><g><rect data-type="rect" data-label="" data-x="172" data-y="66.293315" x="218.5" y="271.72940274999996" width="153" height="13.738928249999958" fill="#2563eb" stroke="#1d4ed8" stroke-width="0.1568627450980392"/></g><g><rect data-type="rect" data-label="" data-x="256" data-y="66.293315" x="754" y="271.72940274999996" width="153" height="13.738928249999958" fill="#2563eb" stroke="#1d4ed8" stroke-width="0.1568627450980392"/></g><g><polygon data-type="polygon" data-label="" data-points="136,42.155126 292,42.155126" points="65.5,432.47982175 1060,432.47982175" fill="none" stroke="#16a34a" stroke-width="3.1875"/></g><g><polygon data-type="polygon" data-label="" data-points="172,68.370878 256,68.370878" points="295,265.35440274999996 830.5,265.35440274999996" fill="none" stroke="#9333ea" stroke-width="10.543128"/></g><text data-type="text" data-label="2 · Fields: solve a cross-section" data-x="132" data-y="98" x="40" y="76.46875" fill="#0f172a" font-size="29.325" font-family="sans-serif" text-anchor="start" dominant-baseline="central">2 · Fields: solve a cross-section</text><text data-type="text" data-label="Transverse x (mm) × stack z (mm); thin layers expanded" data-x="132" data-y="91" x="40" y="121.09375" fill="#475569" font-size="22.95" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Transverse x (mm) × stack z (mm); thin layers expanded</text><text data-type="text" data-label="Dielectric εr=4.42" data-x="137" data-y="53.685439" x="71.875" y="358.974076375" fill="#0f172a" font-size="22.95" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Dielectric εr=4.42</text><text data-type="text" data-label="Dielectric εr=4.1" data-x="137" data-y="63.39981" x="71.875" y="297.04496125" fill="#0f172a" font-size="22.95" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Dielectric εr=4.1</text><text data-type="text" data-label="Mask εr=3.3" data-x="137" data-y="67.107876" x="71.875" y="273.40604049999996" fill="#0f172a" font-size="22.95" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Mask εr=3.3</text><text data-type="text" data-label="Amber: laminate · Cyan: mask εr=3.3 · Blue: copper" data-x="132" data-y="86" x="40" y="152.96875" fill="#475569" font-size="22.95" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Amber: laminate · Cyan: mask εr=3.3 · Blue: copper</text><text data-type="text" data-label="0: 0.100 × 0.035 mm" data-x="164" data-y="80" x="244" y="191.21875" fill="#1d4ed8" font-size="22.95" font-family="sans-serif" text-anchor="start" dominant-baseline="central">0: 0.100 × 0.035 mm</text><text data-type="text" data-label="1: 0.100 × 0.035 mm" data-x="248" data-y="75" x="779.5" y="223.09375" fill="#1d4ed8" font-size="22.95" font-family="sans-serif" text-anchor="start" dominant-baseline="central">1: 0.100 × 0.035 mm</text><text data-type="text" data-label="Reference: bottom · z=0.000 mm" data-x="138" data-y="39.155126" x="78.25" y="451.60482175" fill="#15803d" font-size="22.95" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Reference: bottom · z=0.000 mm</text><text data-type="text" data-label="x: -0.150 … 0.500 mm; z: -0.035 … 1.549 mm" data-x="132" data-y="33" x="40" y="490.84375" fill="#64748b" font-size="22.95" font-family="sans-serif" text-anchor="start" dominant-baseline="central">x: -0.150 … 0.500 mm; z: -0.035 … 1.549 mm</text><text data-type="text" data-label="0: C 50.2 pF/m · L 867.5 nH/m · Z0 131.4 Ω · delay 6.60 ps/mm" data-x="132" data-y="27" x="40" y="529.09375" fill="#0f172a" font-size="22.95" font-family="sans-serif" text-anchor="start" dominant-baseline="central">0: C 50.2 pF/m · L 867.5 nH/m · Z0 131.4 Ω · delay 6.60 ps/mm</text><text data-type="text" data-label="1: C 50.2 pF/m · L 867.5 nH/m · Z0 131.4 Ω · delay 6.60 ps/mm" data-x="132" data-y="22" x="40" y="560.96875" fill="#0f172a" font-size="22.95" font-family="sans-serif" text-anchor="start" dominant-baseline="central">1: C 50.2 pF/m · L 867.5 nH/m · Z0 131.4 Ω · delay 6.60 ps/mm</text><text data-type="text" data-label="Slice -4.00…4.00 mm · 0=TX0.Y → RX0.A /top · 1=TX1.Y → RX1.A /top" data-x="132" data-y="6" x="40" y="662.96875" fill="#64748b" font-size="22.95" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Slice -4.00…4.00 mm · 0=TX0.Y → RX0.A /top · 1=TX1.Y → RX1.A /top</text><text data-type="text" data-label="Strongest pair 0↔1: Cm 24.19 pF/m · Lm 434.88 nH/m · k=0.501" data-x="132" data-y="1" x="40" y="694.84375" fill="#7e22ce" font-size="22.95" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Strongest pair 0↔1: Cm 24.19 pF/m · Lm 434.88 nH/m · k=0.501</text><text data-type="text" data-label="Purple thickness = coupling · 2 conductors · self values above" data-x="132" data-y="-4" x="40" y="726.71875" fill="#64748b" font-size="22.95" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Purple thickness = coupling · 2 conductors · self values above</text><g id="crosshair" style="display: none"><line id="crosshair-h" y1="0" y2="800" stroke="#666" stroke-width="0.5"/><line id="crosshair-v" x1="0" x2="1100" stroke="#666" stroke-width="0.5"/><text id="coordinates" font-family="monospace" font-size="12" fill="#666"></text></g><script><![CDATA[
              document.currentScript.parentElement.addEventListener('mousemove', (e) => {
                const svg = e.currentTarget;
                const rect = svg.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const crosshair = svg.getElementById('crosshair');
                const h = svg.getElementById('crosshair-h');
                const v = svg.getElementById('crosshair-v');
                const coords = svg.getElementById('coordinates');
                
                crosshair.style.display = 'block';
                h.setAttribute('x1', '0');
                h.setAttribute('x2', '1100');
                h.setAttribute('y1', y);
                h.setAttribute('y2', y);
                v.setAttribute('x1', x);
                v.setAttribute('x2', x);
                v.setAttribute('y1', '0');
                v.setAttribute('y2', '800');

                // Calculate real coordinates using inverse transformation
                const matrix = {"a":6.375,"c":0,"e":-801.5,"b":0,"d":-6.375,"f":701.21875};
                // Manually invert and apply the affine transform
                // Since we only use translate and scale, we can directly compute:
                // x' = (x - tx) / sx
                // y' = (y - ty) / sy
                const sx = matrix.a;
                const sy = matrix.d;
                const tx = matrix.e; 
                const ty = matrix.f;
                const realPoint = {
                  x: (x - tx) / sx,
                  y: (y - ty) / sy // Flip y back since we used negative scale
                }
                
                coords.textContent = `(${realPoint.x.toFixed(2)}, ${realPoint.y.toFixed(2)})`;
                coords.setAttribute('x', (x + 5).toString());
                coords.setAttribute('y', (y - 5).toString());
              });
              document.currentScript.parentElement.addEventListener('mouseleave', () => {
                document.currentScript.parentElement.getElementById('crosshair').style.display = 'none';
              });
            ]]></script></svg>