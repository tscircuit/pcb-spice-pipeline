<svg width="1100" height="800" viewBox="0 0 1100 800" xmlns="http://www.w3.org/2000/svg"><rect width="100%" height="100%" fill="white"/><g><polyline data-points="-3.2,-1.92 3.2,-1.92" data-type="line" data-label="" points="142,453.54999999999995 958,453.54999999999995" fill="none" stroke="#11161c" stroke-linejoin="round" stroke-width="408"/></g><g><polyline data-points="-4,0 4,0" data-type="line" data-label="" points="40,208.75 1060,208.75" fill="none" stroke="hsla(195, 90%, 62%, 1)" stroke-linejoin="round" stroke-width="12.75"/></g><g><polyline data-points="-4,0.35 4,0.35" data-type="line" data-label="" points="40,164.125 1060,164.125" fill="none" stroke="hsla(15, 90%, 62%, 1)" stroke-linejoin="round" stroke-width="12.75"/></g><g><polyline data-points="0,0.175 0,-0.32" data-type="line" data-label="" points="550,186.4375 550,249.55" fill="none" stroke="#fbbf24" stroke-linejoin="round" stroke-width="2.5500000000000003" stroke-dasharray="6 4"/></g><g><rect data-type="rect" data-label="" data-x="0" data-y="-2.630926" x="190.96000000000004" y="536.9161937499999" width="718.0799999999999" height="14.553742499999998" fill="#53442f" stroke="black" stroke-width="0.00784313725490196"/></g><g><rect data-type="rect" data-label="" data-x="0" data-y="-2.47767" x="190.96000000000004" y="512.3896562499999" width="718.0799999999999" height="24.526537500000018" fill="#5e4d36" stroke="black" stroke-width="0.00784313725490196"/></g><g><rect data-type="rect" data-label="" data-x="0" data-y="-2.343876" x="190.96000000000004" y="502.7986599999999" width="718.0799999999999" height="9.591060000000084" fill="#53442f" stroke="black" stroke-width="0.00784313725490196"/></g><g><rect data-type="rect" data-label="" data-x="0" data-y="-1.963144" x="190.96000000000004" y="415.3029325" width="718.0799999999999" height="87.49585499999995" fill="#5e4d36" stroke="black" stroke-width="0.00784313725490196"/></g><g><rect data-type="rect" data-label="" data-x="0" data-y="-1.582411" x="190.96000000000004" 