 -0.328533,-0.54331 -0.164267,-0.50976 0,-0.498431 0.164267,-0.50976 0.328533,-0.54331 0.4928,-0.597792 0.657067,-0.671112 0.821333,-0.760453 0.9856,-0.862382 1.149867,-0.972981 1.314133,-1.088 1.314133,-1.088 1.149867,-1.003247 0.9856,-0.92175 0.821333,-0.846643 0.657067,-0.780811 0.4928,-0.726784 0.328533,-0.686638 0.164267,-0.661916 0,-0.653569 -0.164267,-0.661916 -0.328533,-0.686638 -0.4928,-0.726784 -0.657067,-0.780811 -0.821333,-0.846643 -0.9856,-0.92175 -1.149867,-1.003247 -1.314133,-1.088" points="382.44804250000004,347.47 403.3919575,332.8050775 424.336,318.703705 445.28004250000004,305.7077575 466.2239575,294.31678 487.168,284.96848 508.1120425,278.022025 529.0559575,273.7444 550,272.2999525 570.9440425,273.7444 591.8879575,278.022025 612.832,284.96848 633.7760425,294.31678 654.7199575,305.7077575 675.664,318.703705 696.6080425,332.8050775 717.5519575,347.47 717.5519575,347.47 696.6080425,336.6639925 675.664,326.273125 654.7199575,316.6969825 633.7760425,308.3034025 612.832,301.41496 591.8879575,296.296345 570.9440425,293.14429 550,292.0800475 529.0559575,293.14429 508.1120425,296.296345 487.168,301.41496 466.2239575,308.3034025 445.28004250000004,316.6969825 424.336,326.273125 403.3919575,336.6639925 382.44804250000004,347.47" fill="rgba(192, 132, 252, 0.85)" stroke="none" stroke-width="0.00784313725490196"/></g><text data-type="text" data-label="131 Ω" data-x="-1.314133" data-y="-2.976" x="382.44804250000004" y="588.19" fill="hsla(195, 90%, 62%, 1)" font-size="24.48" font-family="sans-serif" text-anchor="middle" dominant-baseline="central">131 Ω</text><text data-type="text" data-label="131 Ω" data-x="1.314133" data-y="-2.976" x="717.5519575" y="588.19" fill="hsla(15, 90%, 62%, 1)" font-size="24.48" font-family="sans-serif" text-anchor="middle" dominant-baseline="central">131 Ω</text><g id="crosshair" style="display: none"><line id="crosshair-h" y1="0" y2="800" stroke="#666" stroke-width="0.5"/><line id="crosshair-v" x1="0" x2="1100" stroke="#666" stroke-width="0.5"/><text id="coordinates" font-family="monospace" font-size="12" fill="#666"></text></g><script><![CDATA[
              document.currentScript.parentElement.addEventListener('mousemove', (e) => {
                const svg = e.currentTarget;
                const rect = svg.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const crosshair = svg.getElementById('crosshair');
                const h = svg.getElementById('crosshair-h');
                const v = svg.getElementById('crosshair-v');
                const coords = svg.getElementById('coordinates');
                
                crosshair.style.display = 'block';
                h.setAttribute('x1', '0');
                h.setAttribute('x2', '1100');
                h.setAttribute('y1', y);
                h.setAttribute('y2', y);
                v.setAttribute('x1', x);
                v.setAttribute('x2', x);
                v.setAttribute('y1', '0');
                v.setAttribute('y2', '800');

                // Calculate real coordinates using inverse transformation
                const matrix = {"a":127.5,"c":0,"e":550,"b":0,"d":-127.5,"f":208.75};
                // Manually invert and apply the affine transform
                // Since we only use translate and scale, we can directly compute:
                // x' = (x - tx) / sx
                // y' = (y - ty) / sy
                const sx = matrix.a;
                const sy = matrix.d;
                const tx = matrix.e; 
                const ty = matrix.f;
                const realPoint = {
                  x: (x - tx) / sx,
                  y: (y - ty) / sy // Flip y back since we used negative scale
                }
                
                coords.textContent = `(${realPoint.x.toFixed(2)}, ${realPoint.y.toFixed(2)})`;
                coords.setAttribute('x', (x + 5).toString());
                coords.setAttribute('y', (y - 5).toString());
              });
              document.currentScript.parentElement.addEventListener('mouseleave', () => {
                document.currentScript.parentElement.getElementById('crosshair').style.display = 'none';
              });
            ]]></script></svg>