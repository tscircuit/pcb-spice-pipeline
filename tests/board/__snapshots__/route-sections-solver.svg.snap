<svg width="1100" height="800" viewBox="0 0 1100 800" xmlns="http://www.w3.org/2000/svg"><rect width="100%" height="100%" fill="white"/><g><polyline data-points="47.5,50 47.5,50 72.5,50 72.5,50" data-type="line" data-label="" points="496.6293706293706,401.7982017982018 496.6293706293706,401.7982017982018 676.4495504495505,401.7982017982018 676.4495504495505,401.7982017982018" fill="none" stroke="#2563eb" stroke-linejoin="round" stroke-width="3.5964035964035967"/></g><g><polyline data-points="47.5,51.09375 47.5,51.09375 72.5,51.09375 72.5,51.09375" data-type="line" data-label="" points="496.6293706293706,393.9310689310689 496.6293706293706,393.9310689310689 676.4495504495505,393.9310689310689 676.4495504495505,393.9310689310689" fill="none" stroke="#2563eb" stroke-linejoin="round" stroke-width="3.5964035964035967"/></g><g><polyline data-points="81.25,57.8125 38.75,57.8125 38.75,65 81.25,65 81.25,57.8125" data-type="line" data-label="" points="739.3866133866134,345.60439560439556 433.6923076923077,345.60439560439556 433.6923076923077,293.9060939060939 739.3866133866134,293.9060939060939 739.3866133866134,345.60439560439556" fill="none" stroke="#16a34a" stroke-linejoin="round" stroke-width="1.4385614385614387"/></g><g><polyline data-points="81.25,35 38.75,35 38.75,65 81.25,65 81.25,35" data-type="line" data-label="" points="739.3866133866134,509.69030969030973 433.6923076923077,509.69030969030973 433.6923076923077,293.9060939060939 739.3866133866134,293.9060939060939 739.3866133866134,509.69030969030973" fill="none" stroke="#16a34a" stroke-linejoin="round" stroke-width="1.4385614385614387"/></g><g><polyline data-points="47.5,50 72.5,50" data-type="line" data-label="" points="496.6293706293706,401.7982017982018 676.4495504495505,401.7982017982018" fill="none" stroke="#2563eb" stroke-linejoin="round" stroke-width="3.2367632367632373"/></g><g><polyline data-points="47.5,51.09375 72.5,51.09375" data-type="line" data-label="" points="496.6293706293706,393.9310689310689 676.4495504495505,393.9310689310689" fill="none" stroke="#0891b2" stroke-linejoin="round" stroke-width="3.2367632367632373"/></g><g><polyline data-points="60,50 57,36" data-type="line" data-label="" points="586.5394605394606,401.7982017982018 564.961038961039,502.4975024975025" fill="none" stroke="#d97706" stroke-linejoin="round" stroke-width="1.078921078921079"/></g><g><rect data-type="rect" data-label="" data-x="60" data-y="50" x="406.71928071928073" y="266.9330669330669" width="359.64035964035975" height="269.7302697302697" fill="none" stroke="#94a3b8" stroke-width="0.13902777777777778"/></g><g><polygon data-type="polygon" data-label="" data-points="59.8125,49.375 60.1875,49.375 60.1875,51.71875 59.8125,51.71875" points="585.1908091908092,406.2937062937063 587.8881118881119,406.2937062937063 587.8881118881119,389.4355644355644 585.1908091908092,389.4355644355644" fill="#fbbf24" stroke="#d97706" stroke-width="1.4385614385614387"/></g><text data-type="text" data-label="1 · Sections: partition routed copper" data-x="2" data-y="98" x="169.35664335664333" y="56.5434565434565" fill="#0f172a" font-size="33.086913086913086" font-family="sans-serif" text-anchor="start" dominant-baseline="central">1 · Sections: partition routed copper</text><text data-type="text" data-label="Board plan · x / y in mm · y points up" data-x="2" data-y="91" x="169.35664335664333" y="106.89310689310685" fill="#334155" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Board plan · x / y in mm · y points up</text><text data-type="text" data-label="2 selected routes; 0/0 neighbour routes shown" data-x="2" data-y="2" x="169.35664335664333" y="747.052947052947" fill="#64748b" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">2 selected routes; 0/0 neighbour routes shown</text><text data-type="text" data-label="TX0.Y → RX0.A" data-x="2" data-y="28" x="169.35664335664333" y="560.0399600399601" fill="#2563eb" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">TX0.Y → RX0.A</text><text data-type="text" data-label="TX1.Y → RX1.A" data-x="62" data-y="28" x="600.925074925075" y="560.0399600399601" fill="#0891b2" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">TX1.Y → RX1.A</text><text data-type="text" data-label="Net colours above · Orange: via" data-x="2" data-y="12" x="169.35664335664333" y="675.1248751248752" fill="#475569" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Net colours above · Orange: via</text><text data-type="text" data-label="Magenta: join · Green: pour" data-x="2" data-y="7" x="169.35664335664333" y="711.0889110889111" fill="#475569" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Magenta: join · Green: pour</text><text data-type="text" data-label="2 wire sections · 1 field slices · 0 via contacts" data-x="2" data-y="87" x="169.35664335664333" y="135.66433566433568" fill="#334155" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">2 wire sections · 1 field slices · 0 via contacts</text><text data-type="text" data-label="Amber: current slice" data-x="57" data-y="34" x="564.961038961039" y="516.8831168831168" fill="#a16207" font-size="25.8941058941059" font-family="sans-serif" text-anchor="start" dominant-baseline="central">Amber: current slice</text><g id="crosshair" style="display: none"><line id="crosshair-h" y1="0" y2="800" stroke="#666" stroke-width="0.5"/><line id="crosshair-v" x1="0" x2="1100" stroke="#666" stroke-width="0.5"/><text id="coordinates" font-family="monospace" font-size="12" fill="#666"></text></g><script><![CDATA[
              document.currentScript.parentElement.addEventListener('mousemove', (e) => {
                const svg = e.currentTarget;
                const rect = svg.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const crosshair = svg.getElementById('crosshair');
                const h = svg.getElementById('crosshair-h');
                const v = svg.getElementById('crosshair-v');
                const coords = svg.getElementById('coordinates');
                
                crosshair.style.display = 'block';
                h.setAttribute('x1', '0');
                h.setAttribute('x2', '1100');
                h.setAttribute('y1', y);
                h.setAttribute('y2', y);
                v.setAttribute('x1', x);
                v.setAttribute('x2', x);
                v.setAttribute('y1', '0');
                v.setAttribute('y2', '800');

                // Calculate real coordinates using inverse transformation
                const matrix = {"a":7.1928071928071935,"c":0,"e":154.97102897102894,"b":0,"d":-7.1928071928071935,"f":761.4385614385615};
                // Manually invert and apply the affine transform
                // Since we only use translate and scale, we can directly compute:
                // x' = (x - tx) / sx
                // y' = (y - ty) / sy
                const sx = matrix.a;
                const sy = matrix.d;
                const tx = matrix.e; 
                const ty = matrix.f;
                const realPoint = {
                  x: (x - tx) / sx,
                  y: (y - ty) / sy // Flip y back since we used negative scale
                }
                
                coords.textContent = `(${realPoint.x.toFixed(2)}, ${realPoint.y.toFixed(2)})`;
                coords.setAttribute('x', (x + 5).toString());
                coords.setAttribute('y', (y - 5).toString());
              });
              document.currentScript.parentElement.addEventListener('mouseleave', () => {
                document.currentScript.parentElement.getElementById('crosshair').style.display = 'none';
              });
            ]]></script></svg>