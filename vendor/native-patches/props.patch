@@ -0,0 +1,46 @@
+import { expect, test } from "bun:test"
+import { chipProps, ibisModelProps, type ChipProps } from "lib"
+
+const ibisModel = {
+  source: "[IBIS Ver] 4.2\n[End]\n",
+  component: "Controller",
+  pins: {
+    OUT: {
+      pin: "P1",
+      mode: "output" as const,
+      stimulus: { type: "clock" as const, period: "5ns", duration: "40ns" },
+    },
+  },
+  power: { vdd: "VDD", vss: "GND" },
+  packageModel: "none" as const,
+}
+test("chip ibisModel parses explicit bindings without mutating input", () => {
+  const raw: ChipProps = { name: "U1", ibisModel }
+  const before = JSON.stringify(raw)
+  expect(chipProps.parse(raw).ibisModel).toEqual(ibisModel)
+  expect(JSON.stringify(raw)).toBe(before)
+})
+test("IBIS URL, source and supply conflicts are actionable", () => {
+  expect(() =>
+    ibisModelProps.parse({
+      ...ibisModel,
+      source: undefined,
+      sourceUrl: "https://example.test/model.ibs",
+    }),
+  ).toThrow("SHA-256")
+  expect(() =>
+    ibisModelProps.parse({
+      ...ibisModel,
+      sourceUrl: "https://example.test/model.ibs",
+    }),
+  ).toThrow("exactly one")
+  expect(() =>
+    ibisModelProps.parse({ ...ibisModel, power: { vdd: "GND", vss: "GND" } }),
+  ).toThrow("different ports")
+  expect(() =>
+    ibisModelProps.parse({
+      ...ibisModel,
+      pins: { OUT: { pin: "P1", mode: "output" } },
+    }),
+  ).toThrow()
+})
