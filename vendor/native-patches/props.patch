index 0000000..f7d6278
--- /dev/null
+++ b/lib/components/chip/ibis.ts
@@ -0,0 +1,73 @@
+import { z } from "zod"
+
+/** Numeric clock times are seconds; string values must include a time unit. */
+const clockTime = z.union([
+  z.number().finite().positive(),
+  z.string().regex(/^\s*\d+(?:\.\d+)?(?:e[+-]?\d+)?\s*(?:s|ms|us|ns|ps)\s*$/i),
+])
+const ibisClock = z.object({
+  type: z.literal("clock"),
+  period: clockTime,
+  duration: clockTime,
+  inverted: z.boolean().optional(),
+})
+
+/** Parent port names are keys; `pin` is the physical pin in the IBIS component. */
+const ibisPinBinding = z.discriminatedUnion("mode", [
+  z
+    .object({
+      pin: z.string().min(1),
+      model: z.string().min(1).optional(),
+      mode: z.literal("input"),
+    })
+    .strict(),
+  z.object({
+    pin: z.string().min(1),
+    model: z.string().min(1).optional(),
+    mode: z.literal("output"),
+    stimulus: ibisClock,
+  }),
+])
+
+/** Table-based IBIS import. Package policy and buffer supply bank are explicit. */
+export const ibisModelProps = z
+  .object({
+    source: z.string().min(1).optional(),
+    sourceUrl: z.string().url().optional(),
+    archivePath: z.string().min(1).optional(),
+    sha256: z
+      .string()
+      .regex(/^[a-f0-9]{64}$/i)
+      .optional(),
+    component: z.string().min(1),
+    pins: z
+      .record(z.string(), ibisPinBinding)
+      .refine(
+        (pins) => Object.keys(pins).length > 0,
+        "Select at least one IBIS pin",
+      ),
+    power: z.object({ vdd: z.string().min(1), vss: z.string().min(1) }),
+    corner: z.enum(["typical", "minimum", "maximum"]).optional(),
+    packageModel: z.enum(["none", "pin_rlc"]),
+  })
+  .superRefine((model, context) => {
+    if (Boolean(model.source) === Boolean(model.sourceUrl))
+      context.addIssue({
+        code: z.ZodIssueCode.custom,
+        message: "Provide exactly one of source or sourceUrl",
+      })
+    if (model.sourceUrl && !model.sha256)
+      context.addIssue({
+        code: z.ZodIssueCode.custom,
+        path: ["sha256"],
+        message: "URL imports require the SHA-256 of the extracted .ibs bytes",
+      })
+    if (model.power.vdd === model.power.vss)
+      context.addIssue({
+        code: z.ZodIssueCode.custom,
+        path: ["power"],
+        message: "VDD and VSS must map to different ports",
+      })
+  })
+
+export type IbisModelProps = z.input<typeof ibisModelProps>
diff --git a/lib/components/eyediagram.ts b/lib/components/eyediagram.ts
new file mode 100644
index 0000000..40cd874
--- /dev/null
+++ b/lib/components/eyediagram.ts
@@ -0,0 +1,68 @@
+import { expectTypesMatch } from "lib/typecheck"
+import { z } from "zod"
+
+export interface EyeDiagramProps {
+  /** Stable name for this differential eye measurement. */
+  name: string
+  /** Selector identifying exactly one positive signal port. */
+  positive: string
+  /** Selector identifying exactly one negative signal port. */
+  negative: string
+  /** Bit interval. Numbers are seconds; strings require s/ms/us/ns/ps units. */
+  unitInterval: number | string
+  /** End of the transient simulation. Numbers are seconds. */
+  duration: number | string
+  /** Maximum transient timestep. Numbers are seconds. */
+  timeStep: number | string
+  /** Exclude startup before this time. Numbers are seconds. Defaults to 0s. */
+  startTime?: number | string
+}
+
+const timeScale = { s: 1, ms: 1e-3, us: 1e-6, ns: 1e-9, ps: 1e-12 }
+const timePattern =
+  /^([+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:e[+-]?\d+)?)\s*(s|ms|us|ns|ps)$/i
+const seconds = z
+  .union([z.number().finite(), z.string().trim().regex(timePattern)])
+  .transform((time) => {
+    if (typeof time === "number") return time
+    const [, magnitude, unit] = time.match(timePattern)!
+    return (
+      Number(magnitude) *
+      timeScale[unit!.toLowerCase() as keyof typeof timeScale]
+    )
+  })
+  .refine(Number.isFinite, "Time must be finite")
+
+const positiveSeconds = seconds.refine(
+  (time) => time > 0,
+  "Time must be positive",
+)
+
+export const eyeDiagramProps = z
+  .object({
+    name: z.string().trim().min(1),
+    positive: z.string().trim().min(1),
+    negative: z.string().trim().min(1),
+    unitInterval: positiveSeconds,
+    duration: positiveSeconds,
+    timeStep: positiveSeconds,
+    startTime: seconds.default("0s"),
+  })
+  .superRefine((eye, context) => {
+    const invalid = (path: keyof EyeDiagramProps, message: string) =>
+      context.addIssue({ code: z.ZodIssueCode.custom, path: [path], message })
+    if (eye.positive === eye.negative)
+      invalid("negative", "EyeDiagram requires two distinct signal ports")
+    if (
+      eye.startTime < 0 ||
+      eye.duration - eye.startTime < 2 * eye.unitInterval
+    )
+      invalid(
+        "startTime",
+        "Recording must include at least two unit intervals after a nonnegative startTime",
+      )
+    if (eye.timeStep > eye.unitInterval / 2)
+      invalid("timeStep", "timeStep must not exceed half the unitInterval")
+  })
+
+expectTypesMatch<EyeDiagramProps, z.input<typeof eyeDiagramProps>>(true)
