+import { expect, test } from "bun:test"
+import type { CircuitJson, PcbCopperPour } from "circuit-json"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+
+test("imported solved copper boundaries, holes, layers and keepout permissions survive native TSX inflation", async () => {
+  const source = getTestFixture().circuit
+  source.add(
+    <board width={24} height={20} routingDisabled>
+      <net name="GND" />
+      <pcbnotetext
+        pcbX={0}
+        pcbY={9}
+        fontSize={0.6}
+        text="Imported copper: rect, polygon, BREP hole and keepout"
+      />
+    </board>,
+  )
+  await source.renderUntilSettled()
+  const imported: CircuitJson = source.getCircuitJson()
+  const net = source.db.source_net.list()[0]!
+  const pours: PcbCopperPour[] = [
+    {
+      type: "pcb_copper_pour",
+      pcb_copper_pour_id: "imported_rect",
+      shape: "rect",
+      center: { x: -7, y: 4 },
+      width: 3,
+      height: 2,
+      rotation: 20,
+      layer: "top",
+      source_net_id: net.source_net_id,
+      covered_with_solder_mask: true,
+    },
+    {
+      type: "pcb_copper_pour",
+      pcb_copper_pour_id: "imported_polygon",
+      shape: "polygon",
+      points: [
+        { x: 2, y: 6 },
+        { x: 6, y: 6 },
+        { x: 5, y: 2 },
+      ],
+      layer: "bottom",
+      source_net_id: net.source_net_id,
+      covered_with_solder_mask: false,
+    },
+    {
+      type: "pcb_copper_pour",
+      pcb_copper_pour_id: "imported_brep",
+      shape: "brep",
+      brep_shape: {
+        outer_ring: {
+          vertices: [
+            { x: -8, y: -2 },
+            { x: -2, y: -2 },
+            { x: -2, y: -8 },
+            { x: -8, y: -8 },
+          ],
+        },
+        inner_rings: [
+          {
+            vertices: [
+              { x: -6, y: -4 },
+              { x: -6, y: -6 },
+              { x: -4, y: -6 },
+              { x: -4, y: -4 },
+            ],
+          },
+        ],
+      },
+      layer: "top",
+      source_net_id: net.source_net_id,
+      covered_with_solder_mask: true,
+    },
+  ]
+  imported.push(...pours, {
+    type: "pcb_keepout",
+    pcb_keepout_id: "imported_keepout",
+    shape: "rect",
+    center: { x: 5, y: -4 },
+    width: 3,
+    height: 2,
+    layers: ["top", "bottom"],
+    allow_placements: true,
+    allow_traces: false,
+    warning_only: true,
+    description: "Imported reserved area",
+  })
+  const before = JSON.stringify(imported)
+  const circuit = getTestFixture().circuit
+  circuit.add(
+    <board circuitJson={imported} width={24} height={20} routingDisabled />,
+  )
+  await circuit.renderUntilSettled()
+  const emittedPours = circuit.db.pcb_copper_pour.list()
+  expect(emittedPours).toHaveLength(pours.length)
+  const geometry = (pour: PcbCopperPour) => {
+    const {
+      pcb_copper_pour_id,
+      source_net_id,
+      subcircuit_id,
+      pcb_group_id,
+      ...shape
+    } = pour
+    return shape
+  }
+  expect(emittedPours.map(geometry)).toEqual(pours.map(geometry))
+  for (const pour of emittedPours)
+    expect(circuit.db.source_net.get(pour.source_net_id!)?.name).toBe("GND")
+  const keepout = circuit.db.pcb_keepout.list()[0]!
+  expect(keepout).toMatchObject({
+    center: { x: 5, y: -4 },
+    width: 3,
+    height: 2,
+    layers: ["top", "bottom"],
+    allow_placements: true,
+    allow_traces: false,
+    warning_only: true,
+    description: "Imported reserved area",
+  })
+  expect(JSON.stringify(imported)).toBe(before)
+  expect(circuit).toMatchPcbSnapshot(import.meta.path)
+})
