+import { expect, test } from "bun:test"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+
+test("board inflation preserves crystal, header and testpoint component types and copper pads", async () => {
+  const fixture = getTestFixture()
+  fixture.circuit.add(
+    <board routingDisabled width="30mm" height="20mm">
+      <crystal
+        name="Y1"
+        frequency="24MHz"
+        loadCapacitance="18pF"
+        footprint="0402"
+        pcbX={-8}
+      />
+      <pinheader name="J1" pinCount={2} pitch="2.54mm" pcbX={0} />
+      <testpoint name="TP1" footprintVariant="pad" padDiameter="1mm" pcbX={8} />
+    </board>,
+  )
+  await fixture.circuit.renderUntilSettled()
+  const imported = fixture.circuit.getCircuitJson()
+  const { circuit } = getTestFixture()
+  circuit.add(<board circuitJson={imported} routingDisabled />)
+  await circuit.renderUntilSettled()
+  const json = circuit.getCircuitJson()
+  const sourceComponents = json.filter((element) => element.type === "source_component")
+  const importedComponents = imported.filter((element) => element.type === "source_component")
+  for (const name of ["Y1", "J1", "TP1"])
+    expect(
+      sourceComponents.find((element) => element.name === name)?.ftype,
+    ).toBe(
+      importedComponents.find((element) => element.name === name)?.ftype,
+    )
+  expect(
+    json
+      .filter((element) => element.type === "pcb_smtpad")
+      .map((pad) => pad.shape === "polygon" ? pad.points : [pad.x, pad.y, pad.shape]),
+  ).toEqual(
+    imported
+      .filter((element) => element.type === "pcb_smtpad")
+      .map((pad) => pad.shape === "polygon" ? pad.points : [pad.x, pad.y, pad.shape]),
+  )
+  expect(circuit).toMatchPcbSnapshot(import.meta.path)
+})
