diff --git a/lib/components/primitive-components/Group/Subcircuit/inflators/inflateImportedCopperAndKeepouts.ts b/lib/components/primitive-components/Group/Subcircuit/inflators/inflateImportedCopperAndKeepouts.ts
new file mode 100644
index 0000000..d7a18f3
--- /dev/null
+++ b/lib/components/primitive-components/Group/Subcircuit/inflators/inflateImportedCopperAndKeepouts.ts
@@ -0,0 +1,219 @@
+import {
+  layer_ref,
+  type PcbCopperPour,
+  type PCBKeepout,
+  type PointWithBulge,
+  type Ring,
+} from "circuit-json"
+import { CopperPour } from "lib/components/primitive-components/CopperPour"
+import { Keepout } from "lib/components/primitive-components/Keepout"
+import type { Net } from "lib/components/primitive-components/Net"
+import {
+  applyToPoint,
+  compose,
+  decomposeTSR,
+  rotateDEG,
+} from "transformation-matrix"
+import type { InflatorContext } from "../InflatorFn"
+
+type CopperPourId = PcbCopperPour["pcb_copper_pour_id"]
+type ImportedCopperState = {
+  copperPourIds: Map<CopperPourId, CopperPourId>
+  traceReferencesUpdated: boolean
+}
+
+/**
+ * Imported points use board/circuit XY, in mm, with +X right and +Y top;
+ * PCB layers locate copper along +Z above / -Z below. The native parent matrix
+ * converts those points (including translation) into the receiving board frame.
+ * Already solved copper boundaries and their holes must not be poured again.
+ */
+class ImportedCopperPour extends CopperPour {
+  private readonly importedPour: PcbCopperPour
+
+  constructor(
+    pour: PcbCopperPour,
+    private readonly importedCopperState: ImportedCopperState,
+    netName?: string,
+  ) {
+    super({
+      layer: pour.layer,
+      connectsTo: netName ? `net.${netName}` : "",
+      coveredWithSolderMask: pour.covered_with_solder_mask,
+    })
+    this.importedPour = structuredClone(pour)
+  }
+
+  // Nets are inflated separately, so preserve floating copper without creating
+  // an empty or guessed net for a pour whose source_net_id was absent.
+  doInitialCreateNetsFromProps(): void {}
+  doInitialPcbViaStitchRender(): void {}
+
+  doInitialPcbCopperPourRender(): void {
+    if (this.root?.pcbDisabled) return
+    const subcircuit = this.getSubcircuit()
+    const pour = structuredClone(this.importedPour)
+    const net = pour.source_net_id
+      ? subcircuit.selectOne<Net>(this._parsedProps.connectsTo)
+      : undefined
+    if (pour.source_net_id && !net?.source_net_id)
+      throw new Error(
+        `Imported copper net "${this._parsedProps.connectsTo.slice(4)}" was not rendered`,
+      )
+
+    // Use PrimitiveComponent's canonical composed matrix; do not rebuild its
+    // rotation/reflection order. circuit-json-util does not transform pours.
+    const matrix = this._computePcbGlobalTransformBeforeLayout()
+    const reflected = matrix.a * matrix.d - matrix.b * matrix.c < 0
+    const transformVertex = (vertex: PointWithBulge): PointWithBulge => ({
+      ...vertex,
+      ...applyToPoint(matrix, vertex),
+      ...(reflected && vertex.bulge !== undefined
+        ? { bulge: -vertex.bulge }
+        : {}),
+    })
+    const transformRing = (ring: Ring): Ring => ({
+      vertices: ring.vertices.map(transformVertex),
+    })
+    if (pour.shape === "brep") {
+      pour.brep_shape = {
+        outer_ring: transformRing(pour.brep_shape.outer_ring),
+        inner_rings: pour.brep_shape.inner_rings.map(transformRing),
+      }
+    } else if (pour.shape === "polygon") {
+      pour.points = pour.points.map((point) => applyToPoint(matrix, point))
+    } else {
+      pour.center = applyToPoint(matrix, pour.center)
+      if (
+        matrix.a !== 1 ||
+        matrix.b !== 0 ||
+        matrix.c !== 0 ||
+        matrix.d !== 1
+      ) {
+        pour.rotation =
+          (decomposeTSR(
+            compose(matrix, rotateDEG(pour.rotation ?? 0)),
+            false,
+            reflected,
+          ).rotation.angle *
+            180) /
+          Math.PI
+      }
+    }
+    pour.layer = this._getPcbPrimitiveFlippedHelpers().maybeFlipLayer(
+      pour.layer,
+    )
+    const { pcb_copper_pour_id: _importedPourId, ...pourInput } = pour
+    const insertedPour = this.root!.db.pcb_copper_pour.insert({
+      ...pourInput,
+      source_net_id: net?.source_net_id,
+      subcircuit_id: subcircuit.subcircuit_id ?? undefined,
+      pcb_group_id: subcircuit.getGroup()?.pcb_group_id ?? undefined,
+    })
+    this.importedCopperState.copperPourIds.set(
+      _importedPourId,
+      insertedPour.pcb_copper_pour_id,
+    )
+  }
+
+  doInitialPcbCopperPourCleanup(): void {
+    if (this.importedCopperState.traceReferencesUpdated) return
+    this.importedCopperState.traceReferencesUpdated = true
+    const subcircuit = this.getSubcircuit()
+    for (const trace of this.root!.db.pcb_trace.list({
+      subcircuit_id: subcircuit.subcircuit_id!,
+    })) {
+      if (
+        !trace.route.some(
+          (point) => "copper_pour_id" in point && point.copper_pour_id,
+        )
+      )
+        continue
+      this.root!.db.pcb_trace.update(trace.pcb_trace_id, {
+        route: trace.route.map((point) => {
+          if (!("copper_pour_id" in point) || !point.copper_pour_id)
+            return point
+          const copperPourId = this.importedCopperState.copperPourIds.get(
+            point.copper_pour_id,
+          )
+          return copperPourId
+            ? { ...point, copper_pour_id: copperPourId }
+            : point
+        }),
+      })
+    }
+  }
+}
+
+class ImportedKeepout extends Keepout {
+  private readonly description?: string
+
+  constructor(keepout: PCBKeepout, excludeRefs: string[]) {
+    if (keepout.shape === "outline")
+      throw new Error(
+        "Imported outline keepouts are not supported by the native keepout primitive",
+      )
+    super({
+      ...(keepout.shape === "rect"
+        ? {
+            shape: "rect" as const,
+            width: keepout.width,
+            height: keepout.height,
+          }
+        : { shape: "circle" as const, radius: keepout.radius }),
+      pcbX: keepout.center.x,
+      pcbY: keepout.center.y,
+      layers: keepout.layers.map((layer) => layer_ref.parse(layer)),
+      warningOnly: keepout.warning_only,
+      allowTraces: keepout.allow_traces,
+      allowPlacements: keepout.allow_placements,
+      excludeRefs,
+    })
+    this.description = keepout.description
+  }
+
+  doInitialPcbPrimitiveRender(): void {
+    super.doInitialPcbPrimitiveRender()
+    if (this.pcb_keepout_id && this.description !== undefined)
+      this.root!.db.pcb_keepout.update(this.pcb_keepout_id, {
+        description: this.description,
+      })
+  }
+}
+
+/** Preserve solved standalone copper/keepouts instead of regenerating them. */
+export function inflateImportedCopperAndKeepouts(
+  context: InflatorContext,
+): void {
+  const { injectionDb, subcircuit } = context
+  const importedCopperState: ImportedCopperState = {
+    copperPourIds: new Map(),
+    traceReferencesUpdated: false,
+  }
+  for (const pour of injectionDb.pcb_copper_pour.list()) {
+    const sourceNet = pour.source_net_id
+      ? injectionDb.source_net.get(pour.source_net_id)
+      : undefined
+    if (pour.source_net_id && !sourceNet)
+      throw new Error("Imported copper has no matching named source net")
+    subcircuit.add(
+      new ImportedCopperPour(pour, importedCopperState, sourceNet?.name),
+    )
+  }
+  for (const keepout of injectionDb.pcb_keepout.list()) {
+    const excludeRefs = (keepout.excluded_pcb_component_ids ?? []).map(
+      (pcbComponentId) => {
+        const pcbComponent = injectionDb.pcb_component.get(pcbComponentId)
+        const sourceComponent = pcbComponent?.source_component_id
+          ? injectionDb.source_component.get(pcbComponent.source_component_id)
+          : undefined
+        if (!sourceComponent)
+          throw new Error(
+            "Imported keepout exclusion has no matching named component",
+          )
+        return `.${sourceComponent.name}`
+      },
+    )
+    subcircuit.add(new ImportedKeepout(keepout, excludeRefs))
+  }
+}
