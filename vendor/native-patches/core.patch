+import { expect, test } from "bun:test"
+import { readFileSync } from "node:fs"
+import { join } from "node:path"
+import { zipSync } from "fflate"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+
+test.skipIf(!process.env.IBIS_FIXTURE_DIR)(
+  "locked Winbond URL imports share a download and finish before simulation",
+  async () => {
+    const bytes = new Uint8Array(
+      readFileSync(join(process.env.IBIS_FIXTURE_DIR!, "W631GG6MB-12.ibs")),
+    )
+    const archive = zipSync({ "W631GG6MB-12.ibs": bytes })
+    let requests = 0,
+      calls = 0,
+      downloaded = false,
+      capturedSpice = ""
+    const { circuit } = getTestFixture({
+      platform: {
+        platformFetch: (async (url: string | URL | Request) => {
+          expect(String(url)).toBe(
+            "https://www.winbond.com/resource-files/w631gg6mb_ibis.zip",
+          )
+          requests++
+          await new Promise((resolve) => setTimeout(resolve, 50))
+          downloaded = true
+          return new Response(Uint8Array.from(archive).buffer)
+        }) as typeof fetch,
+        spiceEngineMap: {
+          ngspice: {
+            simulate: async (source: string) => {
+              if (!downloaded)
+                throw new Error("Simulation started before model download")
+              capturedSpice = source
+              calls++
+              return { simulationResultCircuitJson: [] }
+            },
+          },
+        },
+      },
+    })
+    circuit.add(
+      <board routingDisabled>
+        <voltagesource name="V1" voltage="1.5V" />
+        {["U1", "U2"].map((name, index) => (
+          <chip
+            key={name}
+            name={name}
+            footprint="sot23"
+            schX={index * 3}
+            pinLabels={{ pin1: "DQS", pin2: "VDD", pin3: "GND" }}
+            connections={{
+              DQS: ".V1 > .pin1",
+              VDD: ".V1 > .pin1",
+              GND: ".V1 > .pin2",
+            }}
+            ibisModel={{
+              sourceUrl:
+                "https://www.winbond.com/resource-files/w631gg6mb_ibis.zip",
+              archivePath: "W631GG6MB-12.ibs",
+              sha256:
+                "f2c0f36e24be68fd95a05f34ca4ab875ac5145f1956c5696e9a60b0d8a03e859",
+              component: "W631GG6MB-12",
+              pins: { DQS: { pin: "F3", model: "ODT_60", mode: "input" } },
+              power: { vdd: "VDD", vss: "GND" },
+              packageModel: "pin_rlc",
+            }}
+          />
+        ))}
+        <analogsimulation
+          duration="1ns"
+          timePerStep="5ps"
+          spiceEngine="ngspice"
+        />
+      </board>,
+    )
+    await circuit.renderUntilSettled()
+    expect(requests).toBe(1)
+    expect(
+      circuit
+        .getCircuitJson()
+        .filter(
+          (elm) => elm.type === "source_invalid_component_property_error",
+        ),
+    ).toEqual([])
+    expect(calls).toBe(1)
+    expect(capturedSpice).toContain("* IBIS ODT_60")
+    expect(
+      circuit
+        .getCircuitJson()
+        .filter((elm) => elm.type === "simulation_spice_subcircuit"),
+    ).toHaveLength(2)
+    expect(circuit).toMatchSchematicSnapshot(import.meta.path)
+  },
+  60000,
+)
