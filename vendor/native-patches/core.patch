@@ -0,0 +1,54 @@
+import { expect, test } from "bun:test"
+import type { EyeDiagram } from "lib/components/primitive-components/EyeDiagram"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+
+test("native eyediagram resolves differential ports and serializes seconds without input mutation", async () => {
+  const { circuit } = getTestFixture()
+  const props = Object.freeze({
+    name: "DQS",
+    positive: ".U3 > .DQS",
+    negative: ".U3 > .DQSn",
+    unitInterval: "2.5ns",
+    duration: "100ns",
+    timeStep: "10ps",
+    startTime: "20ns",
+  })
+  circuit.add(
+    <board routingDisabled>
+      <chip
+        name="U3"
+        footprint="sot23"
+        pinLabels={{ pin1: "DQS", pin2: "DQSn", pin3: "GND" }}
+      />
+      <eyediagram {...props} />
+    </board>,
+  )
+  await circuit.renderUntilSettled()
+  const eye = circuit.selectAll("eyediagram")[0]! as EyeDiagram
+  const descriptor = eye.getEyeDiagramDescriptor()
+  const json = circuit.getCircuitJson()
+  const sourcePorts = json.filter((element) => element.type === "source_port")
+  expect(
+    sourcePorts.find(
+      (port) => port.source_port_id === descriptor.positiveSourcePortId,
+    )?.port_hints,
+  ).toContain("DQS")
+  expect(
+    sourcePorts.find(
+      (port) => port.source_port_id === descriptor.negativeSourcePortId,
+    )?.port_hints,
+  ).toContain("DQSn")
+  expect(descriptor.unitIntervalSeconds).toBeCloseTo(2.5e-9, 18)
+  expect(descriptor.durationSeconds).toBeCloseTo(1e-7, 18)
+  expect(descriptor.timeStepSeconds).toBeCloseTo(1e-11, 18)
+  expect(descriptor.startTimeSeconds).toBeCloseTo(2e-8, 18)
+  expect(JSON.parse(JSON.stringify(descriptor))).toEqual(descriptor)
+  descriptor.name = "changed copy"
+  expect(eye.getEyeDiagramDescriptor().name).toBe("DQS")
+  expect(eye._parsedProps.positive).toBe(props.positive)
+  expect(eye.props).toEqual(props)
+  expect(
+    json.filter((element) => element.type.startsWith("simulation_")),
+  ).toEqual([])
+  expect(circuit).toMatchSchematicSnapshot(import.meta.path)
+})
