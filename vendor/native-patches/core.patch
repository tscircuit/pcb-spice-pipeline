diff --git a/tests/features/eyediagram-imported-board.test.tsx b/tests/features/eyediagram-imported-board.test.tsx
new file mode 100644
index 0000000..0b90cfa
--- /dev/null
+++ b/tests/features/eyediagram-imported-board.test.tsx
@@ -0,0 +1,65 @@
+import { expect, test } from "bun:test"
+import type { EyeDiagram } from "lib/components/primitive-components/EyeDiagram"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+
+test("native IBIS annotations and sibling eye measurements work on an immutable imported board", async () => {
+  const fixture = getTestFixture()
+  fixture.circuit.add(
+    <board routingDisabled>
+      <chip
+        name="U3"
+        footprint="sot23"
+        pinLabels={{ pin1: "DQS", pin2: "DQSn", pin3: "GND" }}
+      />
+    </board>,
+  )
+  await fixture.circuit.renderUntilSettled()
+  const imported = fixture.circuit.getCircuitJson()
+  const before = JSON.stringify(imported)
+  const source = `[IBIS Ver] 4.2
+[Component] Input
+[Pin] signal_name model_name
+1 DQS A
+2 DQSn A
+[Model] A
+Model_type Input
+C_comp 1p 1p 1p
+[Voltage Range] 1.5 1.4 1.6
+[End]`
+  const models = Object.freeze({
+    U3: Object.freeze({
+      source,
+      component: "Input",
+      pins: { DQS: { pin: "1", mode: "input" as const } },
+      power: { vdd: "DQSn", vss: "GND" },
+      packageModel: "none" as const,
+    }),
+  })
+  const { circuit } = getTestFixture()
+  circuit.add(
+    <board circuitJson={imported} simIbisModels={models} routingDisabled>
+      <eyediagram
+        name="DQS"
+        positive=".U3 > .DQS"
+        negative=".U3 > .DQSn"
+        unitInterval="2.5ns"
+        duration="100ns"
+        timeStep="10ps"
+      />
+    </board>,
+  )
+  await circuit.renderUntilSettled()
+  const json = circuit.getCircuitJson()
+  expect(
+    json.filter((element) => element.type === "simulation_spice_subcircuit"),
+  ).toHaveLength(1)
+  const descriptor = circuit
+    .selectAll("eyediagram")
+    .map((eye) => (eye as EyeDiagram).getEyeDiagramDescriptor())[0]!
+  expect(descriptor.positiveSourcePortId).not.toBe(
+    descriptor.negativeSourcePortId,
+  )
+  expect(JSON.stringify(imported)).toBe(before)
+  expect(models.U3.pins.DQS).toEqual({ pin: "1", mode: "input" })
+  expect(circuit).toMatchSchematicSnapshot(import.meta.path)
+})
