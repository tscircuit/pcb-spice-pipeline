@@ -0,0 +1,96 @@
+import { eyeDiagramProps } from "@tscircuit/props"
+import type { SourcePort } from "circuit-json"
+import { selectAll } from "css-select"
+import { PrimitiveComponent } from "../base-components/PrimitiveComponent"
+import { cssSelectPrimitiveComponentAdapter } from "../base-components/PrimitiveComponent/cssSelectPrimitiveComponentAdapter"
+import { preprocessSelector } from "../base-components/PrimitiveComponent/preprocessSelector"
+import type { Port } from "./Port"
+
+type SourcePortId = SourcePort["source_port_id"]
+
+/** Resolved measurement intent for an external PCB extraction/simulation runner. */
+export interface EyeDiagramDescriptor {
+  name: string
+  positiveSelector: string
+  negativeSelector: string
+  positiveSourcePortId: SourcePortId
+  negativeSourcePortId: SourcePortId
+  unitIntervalSeconds: number
+  durationSeconds: number
+  timeStepSeconds: number
+  startTimeSeconds: number
+}
+
+export class EyeDiagram extends PrimitiveComponent<typeof eyeDiagramProps> {
+  private eyeDiagramDescriptor: EyeDiagramDescriptor | null = null
+
+  get config() {
+    return { componentName: "EyeDiagram", zodProps: eyeDiagramProps }
+  }
+
+  doInitialSimulationRender() {
+    const {
+      name,
+      positive,
+      negative,
+      unitInterval,
+      duration,
+      timeStep,
+      startTime,
+    } = this._parsedProps
+    const subcircuit = this.getSubcircuit()
+    if (!subcircuit)
+      this.renderError(
+        `EyeDiagram "${name}" must be inside a board or subcircuit`,
+      )
+
+    const resolvePort = (selector: string): SourcePortId => {
+      const ports = selectAll(
+        preprocessSelector(selector, subcircuit! as PrimitiveComponent),
+        subcircuit! as PrimitiveComponent,
+        {
+          adapter: cssSelectPrimitiveComponentAdapter,
+        },
+      ).filter(
+        (candidate): candidate is Port => candidate.componentName === "Port",
+      )
+      if (ports.length !== 1)
+        this.renderError(
+          `EyeDiagram "${name}": selector "${selector}" must identify exactly one signal port; found ${ports.length}`,
+        )
+      if (!ports[0]!.source_port_id)
+        this.renderError(
+          `EyeDiagram "${name}": signal port "${selector}" has not rendered`,
+        )
+      return ports[0]!.source_port_id!
+    }
+
+    const positiveSourcePortId = resolvePort(positive)
+    const negativeSourcePortId = resolvePort(negative)
+    if (positiveSourcePortId === negativeSourcePortId)
+      this.renderError(
+        `EyeDiagram "${name}" requires two distinct signal ports`,
+      )
+
+    this.eyeDiagramDescriptor = {
+      name,
+      positiveSelector: positive,
+      negativeSelector: negative,
+      positiveSourcePortId,
+      negativeSourcePortId,
+      unitIntervalSeconds: unitInterval,
+      durationSeconds: duration,
+      timeStepSeconds: timeStep,
+      startTimeSeconds: startTime,
+    }
+  }
+
+  /** Call after renderUntilSettled(). This declares a measurement; the runner executes it. */
+  getEyeDiagramDescriptor(): EyeDiagramDescriptor {
+    if (!this.eyeDiagramDescriptor)
+      throw new Error(
+        `EyeDiagram "${this._parsedProps.name}" has not resolved; render the circuit before reading its descriptor`,
+      )
+    return { ...this.eyeDiagramDescriptor }
+  }
+}
