@@ -0,0 +1,56 @@
+import { expect, test } from "bun:test"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+
+test("native imported footprints preserve rotated pad world orientation on both board sides", async () => {
+  const fixture = getTestFixture()
+  fixture.circuit.add(
+    <board routingDisabled width="20mm" height="10mm">
+      {(["top", "bottom"] as const).map((layer, index) => (
+        <chip
+          key={layer}
+          name={`U${index + 1}`}
+          layer={layer}
+          pcbRotation={315}
+          pcbX={index ? 4 : -4}
+          pinLabels={{ pin1: "SIGNAL" }}
+        >
+          <footprint originalLayer={layer}>
+            <smtpad
+              shape="rotated_rect"
+              ccwRotation={180}
+              width="0.46mm"
+              height="0.4mm"
+              portHints={["pin1"]}
+            />
+          </footprint>
+        </chip>
+      ))}
+    </board>,
+  )
+  await fixture.circuit.renderUntilSettled()
+  const imported = fixture.circuit.getCircuitJson()
+  const { circuit } = getTestFixture()
+  circuit.add(<board circuitJson={imported} routingDisabled />)
+  await circuit.renderUntilSettled()
+  const describePads = (json: typeof imported) =>
+    json
+      .filter(
+        (element) =>
+          element.type === "pcb_smtpad" && element.shape === "rotated_rect",
+      )
+      .map((pad) => {
+        if (pad.type !== "pcb_smtpad" || pad.shape !== "rotated_rect")
+          throw new Error("Expected rotated pad")
+        return {
+          x: pad.x,
+          y: pad.y,
+          layer: pad.layer,
+          width: pad.width,
+          height: pad.height,
+          rotation: pad.ccw_rotation,
+        }
+      })
+  expect(describePads(circuit.getCircuitJson())).toEqual(describePads(imported))
+  expect(describePads(imported).map((pad) => pad.rotation)).toEqual([135, 135])
+  expect(circuit).toMatchPcbSnapshot(import.meta.path)
+})
diff --git a/tests/features/imported-board-saved-net-routing.test.tsx b/tests/features/imported-board-saved-net-routing.test.tsx
