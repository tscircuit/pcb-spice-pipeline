+      ],
+    ],
+    [
+      90,
+      [
+        { x: 9, y: 2 },
+        { x: 9, y: 4 },
+        { x: 7, y: 2 },
+      ],
+    ],
+    [
+      180,
+      [
+        { x: 8, y: -1 },
+        { x: 6, y: -1 },
+        { x: 8, y: -3 },
+      ],
+    ],
+    [
+      270,
+      [
+        { x: 11, y: -2 },
+        { x: 11, y: -4 },
+        { x: 13, y: -2 },
+      ],
+    ],
+  ] as const) {
+    const source = getTestFixture().circuit
+    source.add(
+      <board width={8} height={8} routingDisabled>
+        <net name="GND" />
+      </board>,
+    )
+    await source.renderUntilSettled()
+    const imported: CircuitJson = source.getCircuitJson()
+    const sourceNetId = source.db.source_net.list()[0]!.source_net_id
+    for (const layer of ["top", "bottom"] as const) {
+      imported.push({
+        type: "pcb_copper_pour",
+        pcb_copper_pour_id: `imported_${layer}`,
+        shape: "polygon",
+        points: [
+          { x: 2, y: 1 },
+          { x: 4, y: 1 },
+          { x: 2, y: 3 },
+        ],
+        source_net_id: sourceNetId,
+        layer,
+        covered_with_solder_mask: true,
+      })
+    }
+    const circuit = getTestFixture().circuit
+    circuit.add(
+      <board
+        circuitJson={imported}
+        width={8}
+        height={8}
+        pcbX={10}
+        pcbRotation={rotation}
+        routingDisabled
+      />,
+    )
+    await circuit.renderUntilSettled()
+    const emitted = circuit.db.pcb_copper_pour.list()
+    expect(emitted.map((pour) => pour.layer)).toEqual(["top", "bottom"])
+    for (const pour of emitted) {
+      if (pour.shape !== "polygon")
+        throw new Error("Imported polygon changed shape")
+      expect(pour.points).toHaveLength(expected.length)
+      for (const [i, point] of pour.points.entries()) {
+        expect(point.x).toBeCloseTo(expected[i]!.x, 10)
+        expect(point.y).toBeCloseTo(expected[i]!.y, 10)
+      }
+    }
+  }
+})
