+import { expect, test } from "bun:test"
+import { readFileSync, writeFileSync } from "node:fs"
+import { join } from "node:path"
+import createNgspiceSpiceEngine from "@tscircuit/ngspice-spice-engine"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+
+// Real vendor data are downloaded/hash-checked by ibis-to-spice's fixture script.
+// The separate integration command sets this path; ordinary core unit tests skip
+// this network/large-file integration case when the fixtures are not provisioned.
+test.skipIf(!process.env.IBIS_FIXTURE_DIR)(
+  "native chip ibisModel runs TI output into a Winbond ODT receiver",
+  async () => {
+    const directory = process.env.IBIS_FIXTURE_DIR!
+    const ngspice = await createNgspiceSpiceEngine()
+    let capturedSpice = ""
+    const { circuit } = getTestFixture({
+      platform: {
+        spiceEngineMap: {
+          ngspice: {
+            simulate: async (source: string) => {
+              capturedSpice = source
+              return ngspice.simulate(source)
+            },
+          },
+        },
+      },
+    })
+    circuit.add(
+      <board routingDisabled schMaxTraceDistance={20}>
+        <voltagesource name="VDDR" voltage="1.5V" />
+        <chip
+          name="UTI"
+          footprint="soic8"
+          pinLabels={{ pin1: "DQS", pin2: "DQSn", pin3: "VDD", pin4: "GND" }}
+          ibisModel={{
+            source: readFileSync(join(directory, "sprm552c.ibs"), "utf8"),
+            component: "am335x_zcz",
+            pins: {
+              DQS: {
+                pin: "P1",
+                model: "Model_655",
+                mode: "output",
+                stimulus: { type: "clock", period: "5ns", duration: "40ns" },
+              },
+              DQSn: {
+                pin: "P2",
+                model: "Model_847",
+                mode: "output",
+                stimulus: {
+                  type: "clock",
+                  period: "5ns",
+                  duration: "40ns",
+                  inverted: true,
+                },
+              },
+            },
+            power: { vdd: "VDD", vss: "GND" },
+            corner: "typical",
+            packageModel: "none",
+          }}
+        />
+        <chip
+          name="UWB"
+          footprint="soic8"
+          pinLabels={{ pin1: "DQS", pin2: "DQSn", pin3: "VDD", pin4: "GND" }}
+          ibisModel={{
+            source: readFileSync(join(directory, "W631GG6MB-12.ibs"), "utf8"),
+            component: "W631GG6MB-12",
+            pins: {
+              DQS: { pin: "F3", model: "ODT_60", mode: "input" },
+              DQSn: { pin: "G3", model: "ODT_60", mode: "input" },
+            },
+            power: { vdd: "VDD", vss: "GND" },
+            packageModel: "pin_rlc",
+          }}
+        />
+        <trace from=".VDDR > .pin1" to=".UTI > .VDD" />
+        <trace from=".VDDR > .pin1" to=".UWB > .VDD" />
+        <trace from=".VDDR > .pin2" to=".UTI > .GND" />
+        <trace from=".VDDR > .pin2" to=".UWB > .GND" />
+        <trace from=".UTI > .DQS" to=".UWB > .DQS" />
+        <trace from=".UTI > .DQSn" to=".UWB > .DQSn" />
+        <voltageprobe
+          name="Winbond_DQS"
+          connectsTo=".UWB > .DQS"
+          referenceTo=".UWB > .DQSn"
+        />
+        <analogsimulation
+          duration="40ns"
+          timePerStep="20ps"
+          spiceEngine="ngspice"
+        />
+      </board>,
+    )
+    await circuit.renderUntilSettled()
+    const json = circuit.getCircuitJson()
+    expect(
+      json.filter(
+        (elm) => elm.type === "source_invalid_component_property_error",
+      ),
+    ).toEqual([])
+    expect(
+      json.filter((elm) => elm.type === "simulation_spice_subcircuit"),
+    ).toHaveLength(2)
+    expect(capturedSpice).toContain("Model_655")
+    expect(capturedSpice).toContain("ODT_60")
+    const graph = json.find(
+      (elm) =>
+        elm.type === "simulation_transient_voltage_graph" &&
+        elm.name === "Winbond_DQS",
+    )
+    expect(graph?.type).toBe("simulation_transient_voltage_graph")
+    if (!graph || graph.type !== "simulation_transient_voltage_graph")
+      throw new Error("No receiver graph")
+    expect(Math.max(...graph.voltage_levels)).toBeGreaterThan(0.8)
+    expect(Math.min(...graph.voltage_levels)).toBeLessThan(-0.8)
+    if (process.env.IBIS_PROOF_DIR && graph.timestamps_ms) {
+      writeFileSync(
+        join(process.env.IBIS_PROOF_DIR, "native-dqs.csv"),
+        "time_s,differential_voltage_V\n" +
+          graph.timestamps_ms
+            .map((time, i) => `${time * 0.001},${graph.voltage_levels[i]}`)
+            .join("\n"),
+      )
+      writeFileSync(
+        join(process.env.IBIS_PROOF_DIR, "native-dqs.cir"),
+        capturedSpice,
+      )
+    }
+    await circuit.renderUntilSettled()
+    expect(
+      circuit
+        .getCircuitJson()
+        .filter((elm) => elm.type === "simulation_spice_subcircuit"),
+    ).toHaveLength(2)
+    await expect(
+      json.filter(
+        (element) =>
+          element.type !== "simulation_transient_voltage_graph" ||
+          element.name === "Winbond_DQS",
+      ),
+    ).toMatchSimulationSnapshot(import.meta.path)
+  },
+  60000,
+)
