index 0000000..9646e03
--- /dev/null
+++ b/lib/components/normal-components/Chip_doInitialIbisModelRender.ts
@@ -0,0 +1,58 @@
+import { IbisError, createIbisModelResolver } from "@tscircuit/ibis-to-spice"
+import type { IRootCircuit } from "lib/IRootCircuit"
+import { SpiceModel } from "../primitive-components/SpiceModel"
+import type { Chip } from "./Chip"
+
+const resolvers = new WeakMap<
+  IRootCircuit,
+  ReturnType<typeof createIbisModelResolver>
+>()
+
+export function Chip_insertIbisModelError(chip: Chip) {
+  if (!chip._ibisModelError || !chip.source_component_id) return
+  chip.root!.db.source_invalid_component_property_error.insert({
+    source_component_id: chip.source_component_id,
+    property_name: "ibisModel",
+    message: `${chip.name}: ${chip._ibisModelError}`,
+    error_type: "source_invalid_component_property_error",
+  })
+}
+
+export function Chip_doInitialIbisModelRender(chip: Chip) {
+  const { ibisModel, spiceModel } = chip._parsedProps
+  if (
+    !ibisModel ||
+    chip._hasStartedIbisModelLoad ||
+    chip.getInheritedProperty("analogSimulationDisabled")
+  )
+    return
+  chip._hasStartedIbisModelLoad = true
+  if (spiceModel) {
+    chip._ibisModelError =
+      "Use either ibisModel or spiceModel on a chip, not both."
+    return
+  }
+  chip._queueAsyncEffect("convert-ibis-model", async () => {
+    try {
+      const root = chip.root!
+      let resolver = resolvers.get(root)
+      if (!resolver) {
+        resolver = createIbisModelResolver(root.platform?.platformFetch)
+        resolvers.set(root, resolver)
+      }
+      const compiled = await resolver(ibisModel)
+      const spiceModel = new SpiceModel({
+        source: compiled.source,
+        spicePinMapping: compiled.spicePinMapping,
+      })
+      spiceModel.sourcePropertyName = "ibisModel"
+      chip.add(spiceModel)
+    } catch (error) {
+      chip._ibisModelError =
+        error instanceof IbisError
+          ? error.message
+          : "IBIS import failed. Check the source file and selected buffer models."
+      Chip_insertIbisModelError(chip)
+    }
+  })
+}
