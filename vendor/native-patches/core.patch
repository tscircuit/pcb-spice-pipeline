+import type { SourceTrace } from "circuit-json"
+import { Net } from "lib/components/primitive-components/Net"
+import { Via } from "lib/components/primitive-components/Via"
+import type { InflatorContext } from "../InflatorFn"
+import { getInflatedPcbPlacement } from "./getInflatedPcbPlacement"
+import { getSelectorPath, inflateSourceTrace } from "./inflateSourceTrace"
+
+/** Import nets and manually placed vias before their connected source traces. */
+export function inflateSourceRouting(context: InflatorContext) {
+  const { injectionDb, subcircuit, groupsMap } = context
+  context.importedViaSelectors = new Map()
+  context.handledPcbViaIds = new Set()
+  for (const sourceNet of injectionDb.source_net.list())
+    subcircuit.add(new Net({ name: sourceNet.name }))
+
+  for (const [index, sourceVia] of injectionDb.source_manually_placed_via
+    .list()
+    .entries()) {
+    const pcbComponent = injectionDb.pcb_component.getWhere({
+      source_component_id: sourceVia.source_manually_placed_via_id,
+    })
+    const originalPorts = injectionDb.source_port.list({
+      source_component_id: sourceVia.source_manually_placed_via_id,
+    })
+    const originalPcbPorts = originalPorts.flatMap((port) =>
+      injectionDb.pcb_port.list({ source_port_id: port.source_port_id }),
+    )
+    const pcbVia = injectionDb.pcb_via
+      .list()
+      .find((via) =>
+        via.pcb_port_ids?.some((pcbPortId) =>
+          originalPcbPorts.some((port) => port.pcb_port_id === pcbPortId),
+        ),
+      )
+    if (!pcbComponent || !pcbVia)
+      throw new Error(
+        "An imported manually placed via has no matching PCB barrel and ports",
+      )
+    const name = `imported_via_${index + 1}`
+    const { pcbX, pcbY } = getInflatedPcbPlacement({
+      pcbComponent,
+      sourceGroupId: sourceVia.source_group_id,
+      inflatorContext: context,
+    })
+    const sourceNet = sourceVia.source_net_id
+      ? injectionDb.source_net.get(sourceVia.source_net_id)
+      : undefined
+    const via = new Via({
+      name,
+      pcbX,
+      pcbY,
+      holeDiameter: pcbVia.hole_diameter,
+      outerDiameter: pcbVia.outer_diameter,
+      fromLayer: pcbVia.from_layer ?? pcbVia.layers[0],
+      toLayer: pcbVia.to_layer ?? pcbVia.layers.at(-1),
+      tented:
+        pcbVia.tented_on_top === undefined &&
+        pcbVia.tented_on_bottom === undefined
+          ? undefined
+          : pcbVia.tented_on_top && pcbVia.tented_on_bottom
+            ? true
+            : pcbVia.tented_on_top
+              ? "top_tented"
+              : pcbVia.tented_on_bottom
+                ? "bottom_tented"
+                : false,
+      connectsTo: sourceNet ? `net.${sourceNet.name}` : undefined,
+    })
+    const group = sourceVia.source_group_id
+      ? groupsMap?.get(sourceVia.source_group_id)
+      : undefined
+    ;(group ?? subcircuit).add(via)
+    context.importedViaSelectors.set(
+      sourceVia.source_manually_placed_via_id,
+      getSelectorPath(
+        { name, source_group_id: sourceVia.source_group_id },
+        context,
+      ),
+    )
+    context.handledPcbViaIds.add(pcbVia.pcb_via_id)
+  }
+}
+
+/** Saved net routing groups have copper routes keyed by source_net_id rather than source_trace_id. */
+export function inflateSavedNetRouting(context: InflatorContext) {
+  const { injectionDb } = context
+  for (const sourceNet of injectionDb.source_net.list()) {
+    if (injectionDb.source_trace.get(sourceNet.source_net_id)) continue
+    const pcbTraces = injectionDb.pcb_trace
+      .list()
+      .filter((trace) => trace.source_trace_id === sourceNet.source_net_id)
+    if (!pcbTraces.length) continue
+    const pcbPortIds = new Set(
+      pcbTraces.flatMap((trace) =>
+        trace.route.flatMap((point) =>
+          point.route_type === "wire"
+            ? [point.start_pcb_port_id, point.end_pcb_port_id].filter(
+                (id) => id !== undefined,
+              )
+            : [],
+        ),
+      ),
+    )
+    const sourcePortIds = [...pcbPortIds].flatMap((id) => {
+      const port = injectionDb.pcb_port.get(id)
+      return port?.source_port_id ? [port.source_port_id] : []
+    })
+    const trace: SourceTrace = {
+      type: "source_trace",
+      source_trace_id: sourceNet.source_net_id,
+      connected_source_port_ids: [...new Set(sourcePortIds)],
+      connected_source_net_ids: [sourceNet.source_net_id],
+    }
+    inflateSourceTrace(trace, context)
+  }
+}
