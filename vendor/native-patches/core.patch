@@ -0,0 +1,73 @@
+import { expect, test } from "bun:test"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+
+test("imported saved-net copper and manual via survive while unrouted logical traces remain unrouted", async () => {
+  const fixture = getTestFixture()
+  fixture.circuit.add(
+    <board
+      routingDisabled
+      layers={4}
+      thickness="1.6mm"
+      width="12mm"
+      height="8mm"
+    >
+      <resistor name="R1" resistance="100" footprint="0402" pcbX={-3} />
+      <resistor name="R2" resistance="100" footprint="0402" pcbX={3} />
+      <via
+        name="V1"
+        pcbX={0}
+        pcbY={1}
+        holeDiameter="0.15mm"
+        outerDiameter="0.3mm"
+        connectsTo="net.GND"
+      />
+      <trace
+        from=".V1 > .top"
+        to=".R1 > .pin1"
+        pcbPath={[
+          { x: 0, y: 1 },
+          { x: -3.51, y: 0 },
+        ]}
+      />
+      <trace from=".R1 > .pin2" to=".R2 > .pin1" />
+    </board>,
+  )
+  await fixture.circuit.renderUntilSettled()
+  const imported = fixture.circuit.getCircuitJson()
+  const net = imported.find(
+    (element) => element.type === "source_net" && element.name === "GND",
+  )
+  if (!net || net.type !== "source_net")
+    throw new Error("Expected original GND net")
+  const originalRoutes = imported.filter(
+    (element) => element.type === "pcb_trace",
+  )
+  expect(originalRoutes).toHaveLength(1)
+  // Saved autorouter control branches use a source-net key in the published board.
+  for (const trace of originalRoutes) trace.source_trace_id = net.source_net_id
+  const before = JSON.stringify(imported)
+  const { circuit } = getTestFixture()
+  circuit.add(<board circuitJson={imported} routingDisabled />)
+  await circuit.renderUntilSettled()
+  const json = circuit.getCircuitJson()
+  const routes = json.filter((element) => element.type === "pcb_trace")
+  const coordinates = (route: (typeof originalRoutes)[number]["route"]) =>
+    route.map((point) =>
+      point.route_type === "wire"
+        ? [point.x, point.y, point.layer, point.width]
+        : point,
+    )
+  expect(routes.map((trace) => coordinates(trace.route))).toEqual(
+    originalRoutes.map((trace) => coordinates(trace.route)),
+  )
+  expect(
+    json.filter((element) => element.type === "source_manually_placed_via"),
+  ).toHaveLength(1)
+  expect(json.filter((element) => element.type === "pcb_via")).toHaveLength(1)
+  expect(json.find((element) => element.type === "pcb_board")).toMatchObject({
+    num_layers: 4,
+    thickness: 1.6,
+  })
+  expect(JSON.stringify(imported)).toBe(before)
+  expect(circuit).toMatchPcbSnapshot(import.meta.path)
+})
